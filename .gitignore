.DS_Store

# OS files
*.DS_Store

# Secrets -- never commit. .env holds ANTHROPIC_API_KEY for docker compose;
# .loki-oauth-credentials.json holds a live Claude Code OAuth token (Auth
# Option 2). .env.example is the committed placeholder template.
.env
.env.*
!.env.example
.loki-oauth-credentials.json

# Python virtualenv
.venv/
dashboard/.venv/

# Node.js
node_modules/
*.log
*.tgz
# v7.5.10: package-lock.json is now committed (was gitignored prior).
# Required for `npm audit` to scan production deps; also gives
# reproducible installs for users who consume `npm install -g loki-mode`.

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Build outputs
dist/
!web-app/dist/
*.vsix

# Local development (not tracked)
the_app/
wiki-repo/

# Runtime state (regenerated each session)
# Source hooks live in autonomy/hooks/ (tracked)
.loki/

# EXCEPTION: test fixtures. tests/fixtures/project-graph/acme/ models a
# multi-repo logical app, and loki_project_graph_discover only activates when
# each member carries a `.loki/app.json` marker. Because `.loki/` above is
# ignored globally, those markers could never be committed -- so the fixture
# shipped with CLAUDE.md files and nothing to discover, and every suite relying
# on it failed from birth while suites that synthesized their own markers
# inline passed. That is the root cause, not the tests.
# Negated narrowly (this one fixture path) rather than by weakening the rule.
!tests/fixtures/**/.loki/
!tests/fixtures/**/.loki/app.json

# Runtime state in subdirectories
dashboard-ui/.loki/
vscode-extension/.loki/

# Hermetic test fixtures under loki-ts/ are intentionally tracked
!loki-ts/tests/fixtures/**/.loki/
!loki-ts/tests/fixtures/**/.loki/**

# Claude Code harness scheduled-tasks lock (transient, per-session)
.claude/scheduled_tasks.lock

# Test artifacts
**/test-results/
.aider*

