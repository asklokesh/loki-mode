#!/usr/bin/env bash
# Loki Mode pre-push hook
#
# D27 retires the local pytest run from this hook: GitHub CI is the gate.
# This hook now only catches what CI cannot catch AFTER the push already
# happened -- the identity and syntax checks below run in well under a
# second and were never the slow part.
#   1. A bash syntax error slips into autonomy/run.sh or autonomy/loki
#   2. The WRONG git identity (Disney murel002) leaking onto a github.com push
#      -- a real past incident: a commit landed as murel002 instead of asklokesh
#      because the repo-local .git/config was not set before committing.
# See docs/dev/release-checklist.md for the full pre-push contract.
#
# git passes the remote name + URL on argv: $1=<name> $2=<url>.
#
# Install:  ./scripts/install-hooks.sh
# Skip once: PRE_PUSH_SKIP=1 git push   (use sparingly; CI will catch you)
#   PRE_PUSH_SKIP never skips the push-authority guard (S-152), the
#   release-notes gate (E-88), or the full-push secret scan (E-110) below --
#   all three run before the PRE_PUSH_SKIP check, deliberately:
#   PRE_PUSH_SKIP=1 is the routine way trains push (see docs/v10/DECISIONS.md),
#   so a check placed after it would never fire on the pushes it exists to
#   catch, including exactly the release-train push that landed E-101's
#   planted secrets (tests/test-eval-archive.sh, commit bbe83c7a).
#   LOKI_ALLOW_UNSCANNED_PUSH=1: lets a push through when the pinned
#   gitleaks binary is missing (E-110). Only covers the full-push scan
#   below, never the eval-fixture scan, and never a real finding or a
#   scanner error either way. Expected to be rare; prefer installing
#   gitleaks (scripts/install-gitleaks.sh) over setting this.

set -euo pipefail

# GITLEAKS_CONFIG / GITLEAKS_CONFIG_TOML let gitleaks pick a config from the
# environment, silently overriding the --config this hook computes from the
# pushed tip's own .gitleaks.toml (E-99). A locally or CI-set value pointing
# at a permissive config must never reach the scan.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

# --- Push-authority guard (S-152) -- runs BEFORE PRE_PUSH_SKIP, never skippable -
# Incident 2026-09-27 18:35Z: an agent inside a .claude/worktrees/* worktree
# committed and pushed 28926937 to origin main. Only the Release Manager / Chief
# of Staff pushes main, and it sets LOKI_RELEASE_MANAGER=1 on every push.
_top="$(git rev-parse --show-toplevel)"
_gd="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
_gcd="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [[ "$_gd" != "$_gcd" && "$_top/" == */.claude/worktrees/* ]]; then
    echo "[pre-push] REFUSED: pushing from a linked worktree under .claude/worktrees ($_top)." >&2
    echo "[pre-push]   Agent worktrees never push; only the Chief of Staff pushes, from the main checkout." >&2
    exit 1
fi
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
# Captured once into a variable: stdin is a pipe and can only be read once,
# but both this guard and the eval-fixture secret scan below (E-86) need it.
_stdin_refs="$(cat)"
while read -r _lref _lsha _rref _rsha; do
    if [[ "$_rref" == "refs/heads/main" && "${LOKI_RELEASE_MANAGER:-}" != "1" ]]; then
        echo "[pre-push] REFUSED: push to refs/heads/main requires LOKI_RELEASE_MANAGER=1." >&2
        echo "[pre-push]   Only the Chief of Staff / Release Manager pushes main. PRE_PUSH_SKIP does not bypass this." >&2
        exit 1
    fi
done <<< "$_stdin_refs"

# --- Release-notes gate (E-88, D36 rework) -- also runs BEFORE PRE_PUSH_SKIP, never skippable -
# release.yml refuses to publish a release whose CHANGELOG.md section for
# VERSION is missing, empty, or not fully written (scripts/release-notes.sh).
# That check is at release time, after the bump already landed on main; this
# catches it earlier, at the push that carries the VERSION bump, using the
# same script against the CHANGELOG.md content of the commit being pushed
# (not the working tree, which may differ). It sits before PRE_PUSH_SKIP
# on purpose (see the header comment): release/train pushes routinely set
# PRE_PUSH_SKIP=1 to skip the retired pytest run, and a gate placed after
# that check would never fire on exactly the pushes it exists to catch.
# `git -C "$_top"` makes every call here independent of the hook's actual
# cwd, since REPO_ROOT/cd below have not run yet at this point.
# Skipped for a branch delete or a push whose remote ref is not
# refs/heads/main -- only a landing on main is a release. Applying this to
# every branch push was itself the bug: a brand-new branch sends an
# all-zero remote sha (or one whose object this clone never fetched), so
# the old code read "old VERSION" as empty, "$_new_version != ''" was
# trivially true, and the push was gated as if it bumped VERSION even
# though it never touched main at all -- refusing ordinary feature-branch
# pushes whenever the branch's own CHANGELOG happened to lack a complete
# section (which most branches never carry, main's is the only one that
# matters).
_remote_name="${1:-origin}"
echo "[pre-push] release-notes gate (VERSION-bump pushes to refs/heads/main only)"
_zero_sha="0000000000000000000000000000000000000000"
_notes_failures=0
while read -r _lref _lsha _rref _rsha; do
    [[ "$_lsha" != "$_zero_sha" ]] || continue          # branch delete: nothing pushed
    [[ "$_rref" == "refs/heads/main" ]] || continue      # only a push that lands on main is a release

    _new_version=""
    if git -C "$_top" cat-file -e "${_lsha}:VERSION" 2>/dev/null; then
        _new_version="$(git -C "$_top" show "${_lsha}:VERSION" 2>/dev/null | tr -d '[:space:]')"
    fi
    [ -n "$_new_version" ] || continue

    # The "old" VERSION to diff against: the remote sha this push claims to
    # move from, if we actually have that object locally -- but a new ref
    # (all-zero remote sha) or a remote sha this clone never fetched both
    # fail that check, and treating "old" as empty in either case makes
    # $_new_version look changed even when main's real content is
    # unchanged. Fall back to this clone's own refs/remotes/<remote>/main,
    # which is the last-known state of main regardless of what the push
    # line says.
    _old_version=""
    if [[ "$_rsha" != "$_zero_sha" ]] && git -C "$_top" cat-file -e "${_rsha}:VERSION" 2>/dev/null; then
        _old_version="$(git -C "$_top" show "${_rsha}:VERSION" 2>/dev/null | tr -d '[:space:]')"
    elif git -C "$_top" cat-file -e "refs/remotes/${_remote_name}/main:VERSION" 2>/dev/null; then
        _old_version="$(git -C "$_top" show "refs/remotes/${_remote_name}/main:VERSION" 2>/dev/null | tr -d '[:space:]')"
    fi
    [ "$_new_version" != "$_old_version" ] || continue    # VERSION unchanged by this push

    if ! git -C "$_top" cat-file -e "${_lsha}:CHANGELOG.md" 2>/dev/null; then
        echo "[pre-push] REFUSED: VERSION is ${_new_version} at ${_lsha} (${_lref}) but that commit has no CHANGELOG.md" >&2
        _notes_failures=$((_notes_failures + 1))
        continue
    fi
    _cl_tmp="$(mktemp "${TMPDIR:-/tmp}/pre-push-changelog.XXXXXX")"
    git -C "$_top" show "${_lsha}:CHANGELOG.md" > "$_cl_tmp" 2>/dev/null
    _cl_err="$(bash "$_top/scripts/release-notes.sh" "$_new_version" --file "$_cl_tmp" 2>&1 >/dev/null)" || {
        echo "[pre-push] REFUSED: CHANGELOG.md at ${_lsha} (${_lref}) has no fully-written release notes for v${_new_version}" >&2
        echo "[pre-push]   $_cl_err" >&2
        _notes_failures=$((_notes_failures + 1))
    }
    rm -f "$_cl_tmp"
done <<< "$_stdin_refs"
if [[ $_notes_failures -gt 0 ]]; then
    echo "[pre-push] $_notes_failures release-notes check(s) failed -- aborting push. PRE_PUSH_SKIP does not bypass this." >&2
    exit 1
fi

# --- Full-push secret scan (gitleaks git, E-110) -- also runs BEFORE PRE_PUSH_SKIP, never skippable -
# The eval-fixture scan further down (E-86/E-99) only ever covers
# eval/loki10/tasks and eval/loki10/refdiff; it never saw the 3 synthetic
# secret-shaped fixtures E-101 planted in tests/test-eval-archive.sh (commit
# bbe83c7a) -- CI's full-history `gitleaks git` gate caught them only after
# the push already landed, blocking the v10.4.0 release. This step runs the
# SAME mode CI uses, over EVERY path in the push, scoped to just the pushed
# commits with --log-opts so it stays fast: measured on this repo, an
# unscoped `gitleaks git` over the full history (~3,700 commits, ~1GB) takes
# ~37s; scoped to a typical 5-commit range with --log-opts it takes ~240ms
# median of 5 runs (~150x faster), plus ~70ms for the clone below. Sits
# here, before PRE_PUSH_SKIP (see the header comment), for the same reason
# E-88 does: trains routinely push with PRE_PUSH_SKIP=1 set
# (docs/v10/DECISIONS.md), and a check placed after that line would never
# run on exactly the pushes that matter most.
#
# Runs against a throwaway `--mirror --shared` clone, not the working tree:
# verified empirically that `gitleaks git <dir>` auto-loads a
# `.gitleaksignore` / `.gitleaks.toml` sitting in that directory's own
# working tree even when neither is passed explicitly -- which would let
# whatever branch happens to be checked out locally silently gate the scan
# instead of the PUSHED TIP's own files, the same class of bug E-99 fixed
# for the eval scan below. A mirror clone has no working tree, so only the
# tip's own copies (fetched below with `git show`, same pattern as the eval
# scan) can apply. `--mirror`, not `--bare`: `--bare` copies only
# refs/heads and tags, so the empty-base fallback's `--not --remotes=...`
# below would match NOTHING inside a `--bare` clone (verified empirically:
# `git -C <bare-clone> for-each-ref refs/remotes` prints 0 lines) and
# silently widen that one fallback case to an unscoped, full-history scan.
# `--mirror` replicates the source's refs/remotes/* 1:1, so `--not
# --remotes=...` bounds the walk there the same way it does in $_top.
# `--shared` hardlinks the object store rather than copying it, which is
# what keeps the clone itself cheap either way. `git -C "$_top"` throughout:
# REPO_ROOT/cd have not run yet at this point (same reason E-88 uses it).
GITLEAKS_VERSION="8.30.0"
_gitleaks_bin=""
_gitleaks_bin_checked=0
_resolve_gitleaks_bin() {
    [[ "$_gitleaks_bin_checked" == "1" ]] && return 0
    _gitleaks_bin_checked=1
    local _bin="$HOME/.local/share/loki/bin/gitleaks-${GITLEAKS_VERSION}"
    local _sidecar="${_bin}.sha256"
    # No PATH fallback: a sidecar-verified pinned install is the only binary
    # this hook trusts. A same-version PATH binary (e.g. Homebrew) is not
    # byte-identical to the pinned release and `gitleaks version` alone
    # cannot prove it is -- that gap is what let a swapped binary through
    # in the installer before this rework (see scripts/install-gitleaks.sh).
    [[ -x "$_bin" ]] || return 0
    [[ -f "$_sidecar" ]] || return 0
    local _recorded _actual
    _recorded="$(cat "$_sidecar" 2>/dev/null || true)"
    [[ -n "$_recorded" ]] || return 0
    if command -v sha256sum >/dev/null 2>&1; then
        _actual="$(sha256sum "$_bin" | awk '{print $1}')"
    else
        _actual="$(shasum -a 256 "$_bin" | awk '{print $1}')"
    fi
    [[ "$_actual" == "$_recorded" ]] || return 0

    # Hardcoded per-platform sha256 of the gitleaks v8.30.0 binary ITSELF
    # (not the release tarball -- scripts/install-gitleaks.sh already pins
    # that, independently). A sidecar match alone is not proof: a sidecar is
    # just a file next to the binary, and whatever can overwrite the binary
    # can overwrite its sidecar to match (E-99). This value lives only in
    # this hook's own git history, verified 2026-09-28 by downloading each
    # official v8.30.0 release asset and hashing the extracted binary (not
    # the tarball -- that hash is the one already pinned in
    # scripts/install-gitleaks.sh and .github/workflows/security-audit.yml).
    local _bin_os _bin_arch _expected_bin_sha256
    case "$(uname -s)" in
        Darwin) _bin_os="darwin" ;;
        Linux) _bin_os="linux" ;;
        *) return 0 ;;
    esac
    case "$(uname -m)" in
        arm64 | aarch64) _bin_arch="arm64" ;;
        x86_64 | amd64) _bin_arch="x64" ;;
        *) return 0 ;;
    esac
    case "${_bin_os}_${_bin_arch}" in
        darwin_arm64) _expected_bin_sha256="095bc4be1624239f52ebb90ff91668d1d3e78e0f8c5286e2d981887905c27561" ;;
        darwin_x64) _expected_bin_sha256="f478677e8858ec3129153dec6e3f8dab5b5f674c120245e7878f89582444d06f" ;;
        linux_arm64) _expected_bin_sha256="3957ad3e168b6633307c1d8ea43bffa17557f825027504b13b574899212e635a" ;;
        linux_x64) _expected_bin_sha256="8b6fd684fcd5b4ebe39b68abb072ce59e1063ce7ed4abd556157697845f1f088" ;;
        *) return 0 ;;
    esac
    [[ "$_actual" == "$_expected_bin_sha256" ]] || return 0

    [[ "$("$_bin" version 2>/dev/null)" == "$GITLEAKS_VERSION" ]] || return 0
    _gitleaks_bin="$_bin"
}

# Scratch dirs for this scan AND the eval-fixture scan further down, each
# created lazily on first use and removed on exit. One trap covers both,
# registered once, here: `trap ... EXIT` REPLACES any earlier registration
# rather than chaining it, so a second `trap ... EXIT` in the eval-scan
# section would silently drop this cleanup. Never swept by path/name/pattern
# elsewhere -- this is the only thing that ever removes either directory,
# and only after confirming each is the exact directory this hook created.
_full_scan_root=""
_eval_scan_root=""
_cleanup_scan_roots() {
    if [[ -n "$_full_scan_root" ]]; then
        case "$_full_scan_root" in
            "${TMPDIR:-/tmp}"/loki-prepush-full.*) rm -rf -- "$_full_scan_root" ;;
        esac
    fi
    if [[ -n "$_eval_scan_root" ]]; then
        case "$_eval_scan_root" in
            "${TMPDIR:-/tmp}"/loki-prepush-eval.*) rm -rf -- "$_eval_scan_root" ;;
        esac
    fi
}
trap '_cleanup_scan_roots' EXIT

# Memoized mirror --shared clone: one per hook run, reused across every
# pushed ref, cleaned up by the trap above since it lives under
# $_full_scan_root.
_full_scan_clone=""
_full_scan_failures=0
while read -r _lref _lsha _rref _rsha; do
    [[ -n "${_lsha:-}" ]] || continue
    [[ "$_lsha" == "$_zero_sha" ]] && continue  # ref delete: nothing pushed

    # Same base-resolution fallback as the eval scan below (own copy: this
    # section runs first, before REPO_ROOT/cd, and duplicating ~10 lines here
    # is safer than threading state across two separate `while read` loops).
    _full_base="$_rsha"
    _full_base_is_empty=0
    if [[ "$_full_base" == "$_zero_sha" ]] || ! git -C "$_top" cat-file -e "${_full_base}^{commit}" 2>/dev/null; then
        _full_base="$(git -C "$_top" merge-base "$_lsha" "refs/remotes/${1:-origin}/main" 2>/dev/null || true)"
        if [[ -z "$_full_base" ]]; then
            _full_base_is_empty=1
        fi
    fi
    if [[ "$_full_base_is_empty" != "1" && "$_full_base" == "$_lsha" ]]; then
        continue  # old tip == new tip: nothing new pushed on this ref
    fi

    _full_log_opts="${_full_base}..${_lsha}"
    [[ "$_full_base_is_empty" == "1" ]] && _full_log_opts="$_lsha --not --remotes=${1:-origin}"

    _resolve_gitleaks_bin
    if [[ -z "$_gitleaks_bin" ]]; then
        if [[ "${LOKI_ALLOW_UNSCANNED_PUSH:-0}" == "1" ]]; then
            echo "[pre-push] WARNING: pinned gitleaks v${GITLEAKS_VERSION} not installed; LOKI_ALLOW_UNSCANNED_PUSH=1 set -- pushing $_lref WITHOUT the full-push secret scan." >&2
            echo "[pre-push]   This never bypasses the eval-fixture scan further down, which still fails closed." >&2
        else
            echo "[pre-push] FAIL: pinned gitleaks v${GITLEAKS_VERSION} is not installed -- cannot run the full-push secret scan for $_lref" >&2
            echo "[pre-push]   install it: scripts/install-gitleaks.sh" >&2
            echo "[pre-push]   or set LOKI_ALLOW_UNSCANNED_PUSH=1 to push anyway (rare; never bypasses the eval-fixture scan, which has no override)." >&2
            _full_scan_failures=$((_full_scan_failures + 1))
        fi
        continue
    fi

    [[ -n "$_full_scan_root" ]] || _full_scan_root="$(mktemp -d "${TMPDIR:-/tmp}/loki-prepush-full.XXXXXX")"
    if [[ -z "$_full_scan_clone" ]]; then
        _full_scan_clone="$_full_scan_root/full-scan.git"
        _full_git_common_dir="$(cd "$_top" && git rev-parse --git-common-dir)"
        case "$_full_git_common_dir" in
            /*) : ;;
            *) _full_git_common_dir="$_top/$_full_git_common_dir" ;;
        esac
        if ! git clone -q --mirror --shared "$_full_git_common_dir" "$_full_scan_clone" 2>/dev/null; then
            echo "[pre-push] FAIL: could not create the scan clone for the full-push secret scan" >&2
            _full_scan_failures=$((_full_scan_failures + 1))
            _full_scan_clone="__failed__"
        fi
    fi
    [[ "$_full_scan_clone" != "__failed__" ]] || continue

    # The PUSHED TIP's ($_lsha) .gitleaksignore / .gitleaks.toml, same E-99
    # invariant as the eval scan: absent on the tip, scan with an empty
    # ignore file (errs strict, never open).
    _full_ignore_file="$_full_scan_root/full-scan.gitleaksignore"
    git -C "$_top" show "$_lsha:.gitleaksignore" > "$_full_ignore_file" 2>/dev/null || : > "$_full_ignore_file"
    _full_config_file="$_full_scan_root/full-scan.gitleaks.toml"
    _full_config_arg=()
    if git -C "$_top" show "$_lsha:.gitleaks.toml" > "$_full_config_file" 2>/dev/null; then
        _full_config_arg=(--config "$_full_config_file")
    fi

    echo "[pre-push] gitleaks git --log-opts=\"$_full_log_opts\" ($_lref, every pushed path)"
    # bash 3.2 (macOS's /bin/bash): "${arr[@]}" on a genuinely empty array is
    # an unbound-variable error under `set -u`. ${arr[@]+"${arr[@]}"} is the
    # portable guard.
    if _full_out="$("$_gitleaks_bin" git "$_full_scan_clone" --log-opts="$_full_log_opts" \
            ${_full_config_arg[@]+"${_full_config_arg[@]}"} \
            --gitleaks-ignore-path "$_full_ignore_file" --redact --no-banner -v 2>&1)"; then
        _full_gl_rc=0
    else
        _full_gl_rc=$?
    fi
    if [[ "$_full_gl_rc" == "1" ]]; then
        # Never the secret: --redact already masks it, and this filter keeps
        # only the location/rule lines even so.
        printf '%s\n' "$_full_out" | grep -E '^(File|Line|RuleID|Fingerprint|Commit):' >&2 || true
        echo "[pre-push] FAIL: gitleaks found a possible secret in the pushed commits (range $_full_log_opts, $_lref)" >&2
        echo "[pre-push]   Verify the finding above. If it is a false positive, add its exact" >&2
        echo "[pre-push]   Fingerprint (printed above) to .gitleaksignore with a one-line reason." >&2
        _full_scan_failures=$((_full_scan_failures + 1))
    elif [[ "$_full_gl_rc" != "0" ]]; then
        # Exit codes other than 0 (clean) and 1 (leaks found) are a scanner
        # failure, not a finding.
        echo "[pre-push] FAIL: gitleaks failed (exit $_full_gl_rc) scanning the pushed commits ($_lref)" >&2
        _full_scan_failures=$((_full_scan_failures + 1))
    fi
done <<< "$_stdin_refs"
if [[ $_full_scan_failures -gt 0 ]]; then
    echo "[pre-push] $_full_scan_failures full-push secret scan check(s) failed -- aborting push. PRE_PUSH_SKIP does not bypass this." >&2
    exit 1
fi

if [[ "${PRE_PUSH_SKIP:-0}" == "1" ]]; then
    echo "[pre-push] PRE_PUSH_SKIP=1 set, skipping"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

failures=0

# --- Identity guard: never push to github.com under the Disney identity -------
# The global gitconfig defaults to murel002 (github.disney.com); a repo that
# forgot to set its local user.email would silently push commits authored as
# murel002 to github.com/asklokesh. Deterministic, no model, fires at the last
# gate before the identity reaches GitHub. Only enforces for github.com remotes
# (github.disney.com pushes legitimately use murel002 and are exempt).
remote_url="${2:-$(git remote get-url --push "${1:-origin}" 2>/dev/null || echo "")}"
if [[ "$remote_url" == *"github.com"* ]]; then
    id_email="$(git config user.email 2>/dev/null || echo "")"
    id_name="$(git config user.name 2>/dev/null || echo "")"
    if [[ "$id_email" != "lokeshmure@live.com" || "$id_name" != "asklokesh" ]]; then
        echo "[pre-push] FAIL: github.com push requires identity asklokesh <lokeshmure@live.com>" >&2
        echo "[pre-push]   current repo identity: ${id_name:-<unset>} <${id_email:-<unset>}>" >&2
        echo "[pre-push]   fix: git config user.name asklokesh && git config user.email lokeshmure@live.com" >&2
        failures=$((failures + 1))
    fi
fi

echo "[pre-push] bash -n autonomy/run.sh"
if ! bash -n autonomy/run.sh; then
    echo "[pre-push] FAIL: autonomy/run.sh has syntax errors" >&2
    failures=$((failures + 1))
fi

echo "[pre-push] bash -n autonomy/loki"
if ! bash -n autonomy/loki; then
    echo "[pre-push] FAIL: autonomy/loki has syntax errors" >&2
    failures=$((failures + 1))
fi

# --- Eval fixture secret scan (gitleaks, E-86) --------------------------------
# CI's Security Audit gitleaks gate (git-log mode, full history) is the
# release-blocking scan; it only runs on a workflow trigger AFTER the push
# already landed. This step catches the same class of finding locally, before
# the push, for the files most likely to carry one: eval task fixtures pull in
# upstream issue text and repo refs verbatim, and a 40-hex commit SHA next to
# a sourcegraph.com URL is exactly what armed the sourcegraph-access-token
# rule on eval/loki10/tasks/pub-werkzeug-3271/task.json (v10.2.0, run
# 36440534022) -- a false positive, fixed with a .gitleaksignore entry, not a
# code change.
#
# `dir` mode is used, not `git`: a local `git log`-scoped scan of just the
# pushed commits did not reproduce that finding at all (verified with both
# v8.30.0 and v8.30.1), so git-log mode is not a reliable local check here.
#
# This scans the PUSHED COMMIT's committed blobs, not the working tree: each
# ref's changed eval paths are extracted from `$_lsha` with `git archive` into
# a throwaway directory and `gitleaks dir` runs there. That means: an
# uncommitted working-tree edit can never mask a committed secret (r2 rework,
# was: `dir` scanned the working tree, so committing a secret and then
# locally overwriting the file without a new commit shipped it unscanned);
# the pushed ref does not need to be checked out (r2 rework, was a hard
# refusal -- extraction from the commit makes that refusal unnecessary, so it
# is gone); and the ref's OWN `.gitleaksignore` (`git show "$_lsha:..."`) is
# what gates it, not whatever happens to be on disk right now.
_zero_sha="0000000000000000000000000000000000000000"
# Computed, not hardcoded: git's well-known empty-tree object id is a 40-hex
# string that, spelled out literally next to this file's own comments about
# sourcegraph.com URLs and secret-scanning, arms gitleaks' sourcegraph-access-
# token rule on this very file (reproduced: 9c8447b1:.githooks/pre-push:115).
# `git hash-object -t tree /dev/null` derives the identical id without ever
# writing the literal.
_empty_tree="$(git hash-object -t tree /dev/null)"
# GITLEAKS_VERSION and _resolve_gitleaks_bin are defined earlier, in the
# full-push secret scan section above (E-110) -- both the eval scan below
# and that section need them, and it runs first.

# B3 (r4, E-86 Opus REJECT on 40b2e228): two changed eval paths in one commit
# that differ only in case ("A.json" vs "a.json"), or only in Unicode
# normalization form, extract on top of each other via `git archive | tar -x`
# on a case-insensitive filesystem (APFS). Prints colliding pairs, one per
# line, or nothing if none collide. python3's `unicodedata` does the real
# NFC-fold; without python3 (ponytail: a narrower fallback, not a missing
# check) this falls back to ASCII case-folding only, which still catches the
# A.json/a.json shape but misses a pure Unicode-normalization collision.
_check_path_collisions() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s\0' "$@" | python3 -c '
import sys, unicodedata
paths = [p for p in sys.stdin.read().split("\0") if p]
seen = {}
for p in paths:
    key = unicodedata.normalize("NFC", p).casefold()
    if key in seen and seen[key] != p:
        print(seen[key] + "\t" + p)
    else:
        seen.setdefault(key, p)
'
    else
        printf '%s\n' "$@" | awk '{k=tolower($0); if (k in seen && seen[k] != $0) print seen[k]"\t"$0; else seen[k]=$0}'
    fi
}

_eval_ref_n=0
while read -r _lref _lsha _rref _rsha; do
    [[ -n "${_lsha:-}" ]] || continue
    [[ "$_lsha" == "$_zero_sha" ]] && continue  # ref delete: nothing pushed

    # A ref need not point at a commit: a lightweight tag can point straight
    # at a tree (or a blob). `^{commit}` peels an annotated tag through to its
    # commit fine, but a tree/blob has none to peel to -- and every commit-
    # walking step below (`git rev-list`, `git diff-tree`) would then either
    # error or silently walk nothing, shipping the ref's content unscanned.
    # Refuse instead of guessing.
    if ! git cat-file -e "${_lsha}^{commit}" 2>/dev/null; then
        echo "[pre-push] FAIL: $_lref points at ${_lsha:0:12}, which is not a commit (a tree or blob ref?) -- refusing rather than skipping the scan" >&2
        failures=$((failures + 1))
        continue
    fi

    _base="$_rsha"
    _base_is_empty_tree=0
    # Only trust $_rsha as a diff base if it both looks non-zero AND actually
    # resolves to a commit THIS repo has. A force-push (or any push where the
    # remote's previous tip was never fetched here) can hand us a well-formed
    # sha that `git diff` cannot read -- `git diff "$_rsha" "$_lsha" || true`
    # then silently reads as "no changes" (r2 rework: that was the bug).
    # Fall back exactly like the new-branch case: merge-base with the
    # remote's main, then the empty tree.
    if [[ "$_base" == "$_zero_sha" ]] || ! git cat-file -e "${_base}^{commit}" 2>/dev/null; then
        _base="$(git merge-base "$_lsha" "refs/remotes/${1:-origin}/main" 2>/dev/null || true)"
        if [[ -z "$_base" ]]; then
            _base="$_empty_tree"
            _base_is_empty_tree=1
        fi
    fi

    # --- every commit in the pushed range, not just the tip (r3 rework) -------
    # Opus re-review of 4e882432 (reproduced with real pushes): scanning only
    # $_lsha's tip tree missed a secret added in one commit and removed again
    # (file deleted, or edited clean) by a LATER commit of the SAME push --
    # it never appears in the base..tip union diff, yet it lands in the
    # remote's history, and CI's git-log-mode gitleaks flags it only
    # afterward. Every commit is now archived and scanned from its own tree.
    _commits_file="$(mktemp "${TMPDIR:-/tmp}/loki-prepush-commits.XXXXXX")"
    _rev_list_rc=0
    if [[ "$_base_is_empty_tree" == "1" ]]; then
        # No usable merge-base: bound the walk to commits no remote-tracking
        # ref already has, instead of the WHOLE history reachable from
        # $_lsha against the empty tree (a normal branch push would then
        # rescan its entire ancestry on every push).
        git rev-list "$_lsha" --not --remotes="${1:-origin}" > "$_commits_file" 2>/dev/null || _rev_list_rc=$?
    else
        git rev-list "${_base}..${_lsha}" > "$_commits_file" 2>/dev/null || _rev_list_rc=$?
    fi
    # Fail closed (r4, E-86 Opus REJECT on 40b2e228): `|| true` here used to
    # swallow a genuine `git rev-list` error (corrupt object, unreadable
    # pack) as an empty commit list, which reads exactly like "nothing to
    # scan" and lets the push through unscanned. A scanner that cannot run is
    # a refusal, not a pass.
    if [[ "$_rev_list_rc" != "0" ]]; then
        echo "[pre-push] FAIL: could not list commits for $_lref (git rev-list exited $_rev_list_rc)" >&2
        rm -f -- "$_commits_file"
        failures=$((failures + 1))
        continue
    fi
    _commits=()
    while IFS= read -r _c; do
        [[ -n "$_c" ]] && _commits+=("$_c")
    done < "$_commits_file"
    rm -f -- "$_commits_file"
    [[ ${#_commits[@]} -gt 0 ]] || continue

    for _csha in "${_commits[@]}"; do
        _eval_ref_n=$((_eval_ref_n + 1))

        # --- .gitleaksignore / .gitleaks.toml drift, PER COMMIT (r4) ----------
        # r3 checked only the push's base..tip union diff of these two files,
        # which a config added in commit 1 and removed again in commit 2 of
        # the SAME push never shows (same class of gap the secret scan itself
        # had, fixed the same way: look at every commit's own change, not the
        # net result). --root: a root commit has no parent to diff against;
        # without it `git diff-tree` on a parentless commit prints nothing
        # (this is also B1 -- see the --root on the scan's diff-tree below).
        _ignore_added="$(git diff-tree -p -m --root -U0 "$_csha" -- .gitleaksignore 2>/dev/null \
            | grep -E '^\+[^+]' | sed 's/^\+//' || true)"
        if [[ -n "$_ignore_added" ]]; then
            echo "[pre-push] WARNING: .gitleaksignore gained line(s) in commit ${_csha:0:12} ($_lref) -- a line here silences a real finding:" >&2
            printf '%s\n' "$_ignore_added" | sed 's/^/[pre-push]   + /' >&2
        fi

        if [[ -n "$(git diff-tree --name-only -m --root "$_csha" -- .gitleaks.toml 2>/dev/null)" ]]; then
            echo "[pre-push] WARNING: .gitleaks.toml added or changed in commit ${_csha:0:12} ($_lref) -- it can silently disable rules:" >&2
            git diff-tree -p -m --root -U0 "$_csha" -- .gitleaks.toml 2>/dev/null | sed 's/^/[pre-push]   /' >&2 || true
            # Any change, not a pattern match against known-bad shapes: a
            # `.*` regex text search is trivially evaded (a title-only config
            # ships zero rules and disables everything just as completely;
            # `paths = [".*"]` excludes every path a different way; a triple-
            # quoted `'''.+'''` regex carries no literal `.*` to grep for).
            # Gitleaks config is small and rare to touch legitimately -- gate
            # on the human, not on guessing which configs are dangerous. Any
            # push, not only one that also touches eval (E-99): a config
            # change is dangerous on its own merits -- it changes what the
            # NEXT eval-touching push, possibly weeks later, gets scanned
            # with -- and gating it on this push's own eval diff let an
            # eval-untouched push slip a weakened config in unreviewed.
            if [[ "${LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE:-0}" != "1" ]]; then
                echo "[pre-push] FAIL: .gitleaks.toml changed (commit ${_csha:0:12}, $_lref) -- it can silently weaken or disable secret scanning" >&2
                echo "[pre-push]   Set LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE=1 to push this anyway." >&2
                failures=$((failures + 1))
            else
                echo "[pre-push]   LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE=1 set -- allowing the config change." >&2
            fi
        fi

        _diff_file="$(mktemp "${TMPDIR:-/tmp}/loki-prepush-diff.XXXXXX")"
        # -z: NUL-separated, unquoted output (non-ASCII path safe, r2). -m:
        # show a merge commit's own diff like a regular commit (a no-op for a
        # non-merge commit). --root (B1, r4): without it a PARENTLESS (root)
        # commit prints no diff at all -- `git diff-tree` treats a root
        # commit as changing nothing unless told to diff it against the
        # empty tree, so an orphan branch or the first push to an empty
        # remote shipped its secret unscanned. --diff-filter=d: a path
        # DELETED by this commit is dropped -- it no longer exists in $_csha
        # to scan, and the earlier commit that added it is its own, separate
        # list entry that still is (this is also what makes a commit whose
        # changed eval paths are ALL deletions fall through to the
        # `[[ ! -s "$_diff_file" ]]` skip below without invoking gitleaks).
        if ! git diff-tree -r --no-commit-id --name-only -z -m --root --diff-filter=d "$_csha" \
                -- eval/loki10/tasks/ eval/loki10/refdiff/ > "$_diff_file" 2>/dev/null; then
            echo "[pre-push] FAIL: could not compute the eval-fixture diff for $_lref (commit ${_csha:0:12})" >&2
            rm -f -- "$_diff_file"
            failures=$((failures + 1))
            continue
        fi
        if [[ ! -s "$_diff_file" ]]; then
            rm -f -- "$_diff_file"
            continue  # skip commits with no eval changes without invoking gitleaks
        fi

        # bash 3.2 (macOS's /bin/bash) has no `mapfile -d`; read NUL-separated
        # entries into an array by hand.
        _eval_paths=()
        while IFS= read -r -d '' _p; do
            _eval_paths+=("$_p")
        done < "$_diff_file"
        rm -f -- "$_diff_file"
        [[ ${#_eval_paths[@]} -gt 0 ]] || continue

        # --- case/Unicode path collision (B3, r4) ------------------------------
        # `git archive | tar -x` extracts by path; on a case-insensitive
        # filesystem (APFS, the default on macOS) two changed paths that
        # differ only in case, or only in Unicode normalization form, extract
        # ON TOP OF each other -- whichever comes last in tar's iteration
        # order wins, and the other is scanned as if it were never changed.
        # Refuse instead of scanning less than what changed.
        _collision="$(_check_path_collisions "${_eval_paths[@]}")"
        if [[ -n "$_collision" ]]; then
            echo "[pre-push] FAIL: commit ${_csha:0:12} ($_lref) changes two eval paths that collide case-insensitively or after Unicode NFC normalization -- extraction on a case-insensitive filesystem would silently overwrite one with the other:" >&2
            printf '%s\n' "$_collision" | sed 's/^/[pre-push]   /' >&2
            failures=$((failures + 1))
            continue
        fi

        _resolve_gitleaks_bin
        if [[ -z "$_gitleaks_bin" ]]; then
            echo "[pre-push] FAIL: eval task fixtures changed but pinned gitleaks v${GITLEAKS_VERSION} is not installed" >&2
            echo "[pre-push]   install it: scripts/install-gitleaks.sh" >&2
            failures=$((failures + 1))
            continue
        fi

        # Measured (r4, 10-commit timing case): archiving + spawning gitleaks
        # for one commit that touches eval costs roughly 270ms. Commits with
        # no eval changes never reach here (skipped above near-instantly),
        # so this only scales with the number of eval-touching commits in a
        # push, not the push's total commit count.
        [[ -n "$_eval_scan_root" ]] || _eval_scan_root="$(mktemp -d "${TMPDIR:-/tmp}/loki-prepush-eval.XXXXXX")"
        _ref_root="$_eval_scan_root/ref-$_eval_ref_n"
        mkdir -p "$_ref_root/tree"

        # Extract exactly the changed eval paths AS COMMITTED at $_csha, in
        # chunks of 500: a single commit with ~20,000 changed eval files blew
        # past the OS argv limit ("Argument list too long") as one `git
        # archive` call. --literal-pathspecs: a filename containing `[` or
        # `*` must not be treated as a glob by the pathspec matcher.
        _archive_err="$_ref_root/archive.err"
        _archive_failed=0
        _i=0
        _n=${#_eval_paths[@]}
        while [[ $_i -lt $_n ]]; do
            _chunk=("${_eval_paths[@]:$_i:500}")
            if ! git --literal-pathspecs archive --format=tar "$_csha" -- "${_chunk[@]}" 2>>"$_archive_err" \
                    | tar -x -C "$_ref_root/tree" 2>>"$_archive_err"; then
                _archive_failed=1
                break
            fi
            _i=$((_i + 500))
        done
        if [[ "$_archive_failed" == "1" ]]; then
            echo "[pre-push] FAIL: could not extract commit ${_csha:0:12}'s eval fixtures for $_lref" >&2
            sed 's/^/[pre-push]   /' "$_archive_err" >&2 2>/dev/null || true
            failures=$((failures + 1))
            continue
        fi

        # `git archive` applies `export-ignore` from the archived tree's own
        # .gitattributes, so a changed path can be silently absent from the
        # archive -- the same class of fail-open as the non-ASCII bug, by a
        # different route. Refuse instead of scanning less than what changed.
        _eval_missing=0
        for _p in "${_eval_paths[@]}"; do
            if [[ ! -e "$_ref_root/tree/$_p" && ! -L "$_ref_root/tree/$_p" ]]; then
                echo "[pre-push] FAIL: $_p changed in commit ${_csha:0:12} ($_lref) but is missing from the archive (export-ignore?)" >&2
                _eval_missing=1
            fi
        done
        if [[ "$_eval_missing" == "1" ]]; then
            failures=$((failures + 1))
            continue
        fi

        # The PUSHED TIP's ($_lsha) .gitleaksignore / .gitleaks.toml, not
        # each commit's own (E-86 round-4 review C1, E-99 fix). CI's git-log
        # gitleaks scan applies ONE ignore file -- the tip's -- to the whole
        # pushed range; scanning each older commit with its OWN, possibly
        # pre-dated, ignore file is a different (looser) check than CI's and
        # can refuse a push CI would pass (an already-reviewed false
        # positive whose .gitleaksignore entry landed after the flagged
        # commit, carried in unchanged by a later merge) as well as pass a
        # push CI would refuse (a secret + its own suppressing line added in
        # commit 1 and the line removed again in commit 2 of the same push:
        # scanning commit 1 with commit 1's own ignore file never sees that
        # the line was self-suppressing and short-lived). Kept outside
        # $_ref_root/tree so neither is itself scanned. Absent on the tip:
        # scan with an empty ignore file (errs strict, never open).
        _ignore_file="$_ref_root/.gitleaksignore"
        git show "$_lsha:.gitleaksignore" > "$_ignore_file" 2>/dev/null || : > "$_ignore_file"

        _config_file="$_ref_root/.gitleaks.toml"
        _config_arg=()
        if git show "$_lsha:.gitleaks.toml" > "$_config_file" 2>/dev/null; then
            _config_arg=(--config "$_config_file")
        fi

        echo "[pre-push] gitleaks dir (commit ${_csha:0:12}, $_lref)"
        # bash 3.2 (macOS's /bin/bash): "${arr[@]}" on a genuinely empty array
        # is an unbound-variable error under `set -u`. ${arr[@]+"${arr[@]}"}
        # is the portable guard -- it expands to nothing when the array is
        # empty instead of dereferencing it.
        if _out="$(cd "$_ref_root/tree" && "$_gitleaks_bin" dir . ${_config_arg[@]+"${_config_arg[@]}"} \
                --gitleaks-ignore-path "$_ignore_file" --redact --no-banner -v 2>&1)"; then
            _gl_rc=0
        else
            _gl_rc=$?
        fi
        if [[ "$_gl_rc" == "1" ]]; then
            # Never the secret: --redact already masks it, and this filter
            # keeps only the location/rule lines even so.
            printf '%s\n' "$_out" | grep -E '^(File|Line|RuleID|Fingerprint):' >&2 || true
            echo "[pre-push] FAIL: gitleaks found a possible secret in a changed eval task fixture (commit ${_csha:0:12}, $_lref)" >&2
            echo "[pre-push]   Verify the finding above. If it is a false positive, add its exact" >&2
            echo "[pre-push]   Fingerprint (printed above) to .gitleaksignore with a one-line reason." >&2
            failures=$((failures + 1))
        elif [[ "$_gl_rc" != "0" ]]; then
            # Exit codes other than 0 (clean) and 1 (leaks found) are a
            # scanner failure (bad flags, crash, unreadable input), not a
            # finding -- saying "found a possible secret" here would
            # misreport a broken scan as a clean-looking refusal reason.
            echo "[pre-push] FAIL: gitleaks failed (exit $_gl_rc) scanning eval fixtures for commit ${_csha:0:12} ($_lref)" >&2
            failures=$((failures + 1))
        fi
    done
done <<< "$_stdin_refs"

# --- Red-main guard ----------------------------------------------------------
# THE FAILURE THIS EXISTS FOR, measured 2026-07-30: main sat RED for THREE
# consecutive releases (v8.0.3, v8.1.0, and the commit before them) because
# nothing ever forced anyone to look. The red was reporting a GENUINE bug the
# whole time -- providers/opencode.sh silently dropped every caller-supplied
# flag -- and three releases shipped straight over it.
#
# A warning, not a block. Whether the tip is red is a fact about the PREVIOUS
# push, and the most common reason to push onto a red main is to FIX it, which
# a hard block would prevent. But it must be impossible to do accidentally: you
# now have to read the words "main is currently RED" before your push proceeds.
#
# Requires gh; silently skipped without it (an offline or gh-less machine still
# pushes normally, and CI remains the backstop).
if command -v gh >/dev/null 2>&1 && [[ "${PRE_PUSH_NO_CI_CHECK:-0}" != "1" ]]; then
    _tip_state=$(gh run list --branch main --workflow=Tests --limit 1 \
                    --json conclusion --jq '.[0].conclusion' 2>/dev/null || echo "")
    if [[ "$_tip_state" == "failure" ]]; then
        echo "[pre-push] ---------------------------------------------------" >&2
        echo "[pre-push] WARNING: main is currently RED (last Tests run failed)." >&2
        echo "[pre-push] If this push is not the fix, you are stacking work on" >&2
        echo "[pre-push] a broken tip -- that is how v8.0.3 through v8.1.0 shipped" >&2
        echo "[pre-push] over a real arg-dropping bug in the opencode provider." >&2
        echo "[pre-push]   gh run list --branch main --workflow=Tests --limit 1" >&2
        echo "[pre-push] ---------------------------------------------------" >&2
    fi
fi

if [[ $failures -gt 0 ]]; then
    echo "[pre-push] $failures check(s) failed -- aborting push" >&2
    echo "[pre-push] Re-run after fixing, or skip with PRE_PUSH_SKIP=1 git push" >&2
    exit 1
fi

echo "[pre-push] all checks passed"
