#!/usr/bin/env bash
# Loki Mode pre-push hook
#
# GitHub CI is the gate; this hook does not run the test suite.
# It only catches what CI cannot catch AFTER the push already
# happened -- the identity and syntax checks below run in well under a
# second and were never the slow part.
#   1. A bash syntax error slips into autonomy/run.sh or autonomy/loki
#   2. The WRONG git identity (Disney murel002) leaking onto a github.com push
#      -- a real past incident: a commit landed as murel002 instead of asklokesh
#      because the repo-local .git/config was not set before committing.
# See docs/dev/release-checklist.md for the full pre-push contract.
#
# git passes the remote name + URL on argv: $1=<name> $2=<url>.
#
# Install:  ./scripts/install-hooks.sh
# Skip once: PRE_PUSH_SKIP=1 git push   (use sparingly; CI will catch you)
#   PRE_PUSH_SKIP never skips the push-authority guard, the
#   release-notes gate, or the full-push secret scan below --
#   all three run before the PRE_PUSH_SKIP check, deliberately:
#   PRE_PUSH_SKIP=1 is a routine way automated pushes skip the hook,
#   so a check placed after it would never fire on the pushes it exists to
#   catch.
#   LOKI_ALLOW_UNSCANNED_PUSH=1: lets a push through when the pinned
#   gitleaks binary is missing. Only covers the full-push scan
#   below, and never a real finding or a
#   scanner error either way. Expected to be rare; prefer installing
#   gitleaks (scripts/install-gitleaks.sh) over setting this.

set -euo pipefail

# GITLEAKS_CONFIG / GITLEAKS_CONFIG_TOML let gitleaks pick a config from the
# environment, silently overriding the --config this hook computes from the
# pushed tip's own .gitleaks.toml. A locally or CI-set value pointing
# at a permissive config must never reach the scan.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

# --- Push-authority guard -- runs BEFORE PRE_PUSH_SKIP, never skippable -
# Pushing from a linked worktree under .claude/worktrees is refused. Pushes to
# main are made from the main checkout with LOKI_RELEASE_MANAGER=1 set.
_top="$(git rev-parse --show-toplevel)"
_gd="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
_gcd="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [[ "$_gd" != "$_gcd" && "$_top/" == */.claude/worktrees/* ]]; then
    echo "[pre-push] REFUSED: pushing from a linked worktree under .claude/worktrees ($_top)." >&2
    echo "[pre-push]   Linked worktrees never push; push from the main checkout." >&2
    exit 1
fi
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.
# Captured once into a variable: stdin is a pipe and can only be read once,
# but several guards read it.
_stdin_refs="$(cat)"
while read -r _lref _lsha _rref _rsha; do
    if [[ "$_rref" == "refs/heads/main" && "${LOKI_RELEASE_MANAGER:-}" != "1" ]]; then
        echo "[pre-push] REFUSED: push to refs/heads/main requires LOKI_RELEASE_MANAGER=1." >&2
        echo "[pre-push]   Pushes to main are made from the main checkout with that variable set. PRE_PUSH_SKIP does not bypass this." >&2
        exit 1
    fi
done <<< "$_stdin_refs"

# --- Release-notes gate -- also runs BEFORE PRE_PUSH_SKIP, never skippable -
# release.yml refuses to publish a release whose CHANGELOG.md section for
# VERSION is missing, empty, or not fully written (scripts/release-notes.sh).
# That check is at release time, after the bump already landed on main; this
# catches it earlier, at the push that carries the VERSION bump, using the
# same script against the CHANGELOG.md content of the commit being pushed
# (not the working tree, which may differ). It sits before PRE_PUSH_SKIP
# on purpose (see the header comment): release/train pushes routinely set
# PRE_PUSH_SKIP=1 to skip the retired pytest run, and a gate placed after
# that check would never fire on exactly the pushes it exists to catch.
# `git -C "$_top"` makes every call here independent of the hook's actual
# cwd, since REPO_ROOT/cd below have not run yet at this point.
# Skipped for a branch delete or a push whose remote ref is not
# refs/heads/main -- only a landing on main is a release. Applying this to
# every branch push was itself the bug: a brand-new branch sends an
# all-zero remote sha (or one whose object this clone never fetched), so
# the old code read "old VERSION" as empty, "$_new_version != ''" was
# trivially true, and the push was gated as if it bumped VERSION even
# though it never touched main at all -- refusing ordinary feature-branch
# pushes whenever the branch's own CHANGELOG happened to lack a complete
# section (which most branches never carry, main's is the only one that
# matters).
_remote_name="${1:-origin}"
echo "[pre-push] release-notes gate (VERSION-bump pushes to refs/heads/main only)"
_zero_sha="0000000000000000000000000000000000000000"
_notes_failures=0
while read -r _lref _lsha _rref _rsha; do
    [[ "$_lsha" != "$_zero_sha" ]] || continue          # branch delete: nothing pushed
    [[ "$_rref" == "refs/heads/main" ]] || continue      # only a push that lands on main is a release

    _new_version=""
    if git -C "$_top" cat-file -e "${_lsha}:VERSION" 2>/dev/null; then
        _new_version="$(git -C "$_top" show "${_lsha}:VERSION" 2>/dev/null | tr -d '[:space:]')"
    fi
    [ -n "$_new_version" ] || continue

    # The "old" VERSION to diff against: the remote sha this push claims to
    # move from, if we actually have that object locally -- but a new ref
    # (all-zero remote sha) or a remote sha this clone never fetched both
    # fail that check, and treating "old" as empty in either case makes
    # $_new_version look changed even when main's real content is
    # unchanged. Fall back to this clone's own refs/remotes/<remote>/main,
    # which is the last-known state of main regardless of what the push
    # line says.
    _old_version=""
    if [[ "$_rsha" != "$_zero_sha" ]] && git -C "$_top" cat-file -e "${_rsha}:VERSION" 2>/dev/null; then
        _old_version="$(git -C "$_top" show "${_rsha}:VERSION" 2>/dev/null | tr -d '[:space:]')"
    elif git -C "$_top" cat-file -e "refs/remotes/${_remote_name}/main:VERSION" 2>/dev/null; then
        _old_version="$(git -C "$_top" show "refs/remotes/${_remote_name}/main:VERSION" 2>/dev/null | tr -d '[:space:]')"
    fi
    [ "$_new_version" != "$_old_version" ] || continue    # VERSION unchanged by this push

    if ! git -C "$_top" cat-file -e "${_lsha}:CHANGELOG.md" 2>/dev/null; then
        echo "[pre-push] REFUSED: VERSION is ${_new_version} at ${_lsha} (${_lref}) but that commit has no CHANGELOG.md" >&2
        _notes_failures=$((_notes_failures + 1))
        continue
    fi
    _cl_tmp="$(mktemp "${TMPDIR:-/tmp}/pre-push-changelog.XXXXXX")"
    git -C "$_top" show "${_lsha}:CHANGELOG.md" > "$_cl_tmp" 2>/dev/null
    _cl_err="$(bash "$_top/scripts/release-notes.sh" "$_new_version" --file "$_cl_tmp" 2>&1 >/dev/null)" || {
        echo "[pre-push] REFUSED: CHANGELOG.md at ${_lsha} (${_lref}) has no fully-written release notes for v${_new_version}" >&2
        echo "[pre-push]   $_cl_err" >&2
        _notes_failures=$((_notes_failures + 1))
    }
    rm -f "$_cl_tmp"
done <<< "$_stdin_refs"
if [[ $_notes_failures -gt 0 ]]; then
    echo "[pre-push] $_notes_failures release-notes check(s) failed -- aborting push. PRE_PUSH_SKIP does not bypass this." >&2
    exit 1
fi

# --- Full-push secret scan (gitleaks git, E-110) -- also runs BEFORE PRE_PUSH_SKIP, never skippable -
# Synthetic secret-shaped fixtures planted in a test file were once caught only
# by CI's full-history `gitleaks git` gate, after
# the push already landed, blocking the v10.4.0 release. This step runs the
# SAME mode CI uses, over EVERY path in the push, scoped to just the pushed
# commits with --log-opts so it stays fast: measured on this repo, an
# unscoped `gitleaks git` over the full history (~3,700 commits, ~1GB) takes
# ~37s; scoped to a typical 5-commit range with --log-opts it takes ~240ms
# median of 5 runs (~150x faster), plus ~70ms for the clone below. Sits
# here, before PRE_PUSH_SKIP (see the header comment), for the same reason
# E-88 does: automated pushes routinely set PRE_PUSH_SKIP=1, and a check
# placed after that line would never run on exactly the pushes that matter most.
#
# Runs against a throwaway `--mirror --shared` clone, not the working tree:
# verified empirically that `gitleaks git <dir>` auto-loads a
# `.gitleaksignore` / `.gitleaks.toml` sitting in that directory's own
# working tree even when neither is passed explicitly -- which would let
# whatever branch happens to be checked out locally silently gate the scan
# instead of the PUSHED TIP's own files, the same class of bug E-99 fixed
# for the eval scan below. A mirror clone has no working tree, so only the
# tip's own copies (fetched below with `git show`, same pattern as the eval
# scan) can apply. `--mirror`, not `--bare`: `--bare` copies only
# refs/heads and tags, so the empty-base fallback's `--not --remotes=...`
# below would match NOTHING inside a `--bare` clone (verified empirically:
# `git -C <bare-clone> for-each-ref refs/remotes` prints 0 lines) and
# silently widen that one fallback case to an unscoped, full-history scan.
# `--mirror` replicates the source's refs/remotes/* 1:1, so `--not
# --remotes=...` bounds the walk there the same way it does in $_top.
# `--shared` hardlinks the object store rather than copying it, which is
# what keeps the clone itself cheap either way. `git -C "$_top"` throughout:
# REPO_ROOT/cd have not run yet at this point (same reason E-88 uses it).
GITLEAKS_VERSION="8.30.0"
# Defined once; the echo and the real scan below both use it.
_gitleaks_merge_mode="--diff-merges=first-parent"

# A hung gitleaks process (huge object, pathological regex backtrack) should
# not hang the push forever. `timeout` is GNU coreutils; on a machine without
# it (or without the `gtimeout` Homebrew alias on macOS) this is simply a
# no-op prefix -- best-effort, not a security control, so its absence never
# blocks a push on its own.
_gitleaks_timeout_prefix=()
if command -v timeout >/dev/null 2>&1; then
    _gitleaks_timeout_prefix=(timeout 120)
elif command -v gtimeout >/dev/null 2>&1; then
    _gitleaks_timeout_prefix=(gtimeout 120)
fi

_gitleaks_bin=""
_gitleaks_bin_checked=0
_resolve_gitleaks_bin() {
    [[ "$_gitleaks_bin_checked" == "1" ]] && return 0
    _gitleaks_bin_checked=1
    local _bin="$HOME/.local/share/loki/bin/gitleaks-${GITLEAKS_VERSION}"
    local _sidecar="${_bin}.sha256"
    # No PATH fallback: a sidecar-verified pinned install is the only binary
    # this hook trusts. A same-version PATH binary (e.g. Homebrew) is not
    # byte-identical to the pinned release and `gitleaks version` alone
    # cannot prove it is -- that gap is what let a swapped binary through
    # in the installer before this rework (see scripts/install-gitleaks.sh).
    [[ -x "$_bin" ]] || return 0
    [[ -f "$_sidecar" ]] || return 0
    local _recorded _actual
    _recorded="$(cat "$_sidecar" 2>/dev/null || true)"
    [[ -n "$_recorded" ]] || return 0
    if command -v sha256sum >/dev/null 2>&1; then
        _actual="$(sha256sum "$_bin" | awk '{print $1}')"
    else
        _actual="$(shasum -a 256 "$_bin" | awk '{print $1}')"
    fi
    [[ "$_actual" == "$_recorded" ]] || return 0

    # Hardcoded per-platform sha256 of the gitleaks v8.30.0 binary ITSELF
    # (not the release tarball -- scripts/install-gitleaks.sh already pins
    # that, independently). A sidecar match alone is not proof: a sidecar is
    # just a file next to the binary, and whatever can overwrite the binary
    # can overwrite its sidecar to match. This value lives only in
    # this hook's own git history, verified 2026-09-28 by downloading each
    # official v8.30.0 release asset and hashing the extracted binary (not
    # the tarball -- that hash is the one already pinned in
    # scripts/install-gitleaks.sh and .github/workflows/security-audit.yml).
    local _bin_os _bin_arch _expected_bin_sha256
    case "$(uname -s)" in
        Darwin) _bin_os="darwin" ;;
        Linux) _bin_os="linux" ;;
        *) return 0 ;;
    esac
    case "$(uname -m)" in
        arm64 | aarch64) _bin_arch="arm64" ;;
        x86_64 | amd64) _bin_arch="x64" ;;
        *) return 0 ;;
    esac
    case "${_bin_os}_${_bin_arch}" in
        darwin_arm64) _expected_bin_sha256="095bc4be1624239f52ebb90ff91668d1d3e78e0f8c5286e2d981887905c27561" ;;
        darwin_x64) _expected_bin_sha256="f478677e8858ec3129153dec6e3f8dab5b5f674c120245e7878f89582444d06f" ;;
        linux_arm64) _expected_bin_sha256="3957ad3e168b6633307c1d8ea43bffa17557f825027504b13b574899212e635a" ;;
        linux_x64) _expected_bin_sha256="8b6fd684fcd5b4ebe39b68abb072ce59e1063ce7ed4abd556157697845f1f088" ;;
        *) return 0 ;;
    esac
    [[ "$_actual" == "$_expected_bin_sha256" ]] || return 0

    [[ "$("$_bin" version 2>/dev/null)" == "$GITLEAKS_VERSION" ]] || return 0
    _gitleaks_bin="$_bin"
}

# Scratch dir for this scan, created lazily on first use and removed on exit.
# Never swept by path/name/pattern elsewhere -- this is the only thing that ever
# removes it, and only after confirming it is the exact directory this hook created.
_full_scan_root=""
_cleanup_scan_roots() {
    if [[ -n "$_full_scan_root" ]]; then
        case "$_full_scan_root" in
            "${TMPDIR:-/tmp}"/loki-prepush-full.*) rm -rf -- "$_full_scan_root" ;;
        esac
    fi
}
trap '_cleanup_scan_roots' EXIT

# Memoized mirror --shared clone: one per hook run, reused across every
# pushed ref, cleaned up by the trap above since it lives under
# $_full_scan_root.
_full_scan_clone=""
_full_scan_failures=0
while read -r _lref _lsha _rref _rsha; do
    [[ -n "${_lsha:-}" ]] || continue
    [[ "$_lsha" == "$_zero_sha" ]] && continue  # ref delete: nothing pushed

    # A ref need not point at a commit (a lightweight tag can point straight
    # at a tree or a blob). Caught here too, not only by the eval scan's own
    # copy of this check further down: `git log <tree-oid> --not
    # --remotes=...` (what --log-opts passes straight through to) does not
    # error on a non-commit oid, it silently walks ZERO commits and gitleaks
    # exits 0 -- a real fail-open, reproduced with case 27b (a tree ref
    # carrying a secret, pushed with PRE_PUSH_SKIP=1 so dir-mode's own
    # equivalent check, further down, never runs to catch it either).
    if ! git -C "$_top" cat-file -e "${_lsha}^{commit}" 2>/dev/null; then
        echo "[pre-push] FAIL: $_lref points at ${_lsha:0:12}, which is not a commit (a tree or blob ref?) -- refusing rather than skipping the full-push scan" >&2
        _full_scan_failures=$((_full_scan_failures + 1))
        continue
    fi

    # Same base-resolution fallback as the eval scan below (own copy: this
    # section runs first, before REPO_ROOT/cd, and duplicating ~10 lines here
    # is safer than threading state across two separate `while read` loops).
    _full_base="$_rsha"
    _full_base_is_empty=0
    if [[ "$_full_base" == "$_zero_sha" ]] || ! git -C "$_top" cat-file -e "${_full_base}^{commit}" 2>/dev/null; then
        _full_base="$(git -C "$_top" merge-base "$_lsha" "refs/remotes/${1:-origin}/main" 2>/dev/null || true)"
        if [[ -z "$_full_base" ]]; then
            _full_base_is_empty=1
        fi
    fi
    if [[ "$_full_base_is_empty" != "1" && "$_full_base" == "$_lsha" ]]; then
        continue  # old tip == new tip: nothing new pushed on this ref
    fi

    _full_log_opts="${_full_base}..${_lsha}"
    [[ "$_full_base_is_empty" == "1" ]] && _full_log_opts="$_lsha --not --remotes=${1:-origin}"

    # A line added to .gitleaksignore silences a real finding: warn, per pushed range.
    # shellcheck disable=SC2086
    _ignore_added="$(git -C "$_top" log -p --diff-merges=first-parent -U0 --format= $_full_log_opts -- .gitleaksignore 2>/dev/null \
        | grep -E '^\+[^+]' | sed 's/^\+//' || true)"
    if [[ -n "$_ignore_added" ]]; then
        echo "[pre-push] WARNING: .gitleaksignore gained line(s) in the pushed range ($_lref) -- a line here silences a real finding:" >&2
        printf '%s\n' "$_ignore_added" | sed 's/^/[pre-push]   + /' >&2
    fi

    # --- .gitleaks.toml change gate ------------------------------------------
    # Opus REJECT, reproduced: a push made with PRE_PUSH_SKIP=1 (the routine
    # way trains push) could add a commit with a zero-rule .gitleaks.toml
    # ("title = \"x\"", no [[rules]]) plus a commit with a real secret. The
    # eval scan's own .gitleaks.toml refusal sat AFTER the PRE_PUSH_SKIP exit,
    # so it never ran; the full-push scan below used the pushed TIP's own
    # .gitleaks.toml (E-99's tip-trust invariant), which is exactly the
    # attacker's weakened config -- it found nothing, and the secret landed.
    # This existence check (word-split $_full_log_opts intentionally: it is
    # either "base..tip" or "tip --not --remotes=origin", both valid `git
    # rev-list` range syntax, built internally by this hook, never from
    # pushed content) runs before PRE_PUSH_SKIP and before the binary check,
    # same as the eval scan's own gate needs neither. LOKI_ALLOW_GITLEAKS_
    # CONFIG_CHANGE=1 is still the only override; the eval scan's own
    # copy of this gate, further down, still runs too when PRE_PUSH_SKIP is
    # unset, and still prints the itemized per-commit diff.
    # Fail closed: `|| true` here used to swallow a genuine `git
    # rev-list` error (corrupt object, unreadable pack) as "no .gitleaks.toml
    # change", which falls back to trusting the pushed tip's own config --
    # exactly the attacker's weakened-config scenario this gate exists to
    # catch. A check that cannot run is a refusal, not a pass, same as the
    # per-commit `git rev-list` fail-closed further down.
    _toml_changed_rc=0
    # shellcheck disable=SC2086
    _toml_changed_commits="$(git -C "$_top" rev-list $_full_log_opts -- .gitleaks.toml 2>/dev/null)" || _toml_changed_rc=$?
    if [[ "$_toml_changed_rc" != "0" ]]; then
        echo "[pre-push] FAIL: could not check whether .gitleaks.toml changed in the pushed range ($_lref) (git rev-list exited $_toml_changed_rc)" >&2
        _full_scan_failures=$((_full_scan_failures + 1))
        continue
    fi
    if [[ -n "$_toml_changed_commits" ]]; then
        if [[ "${LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE:-0}" != "1" ]]; then
            echo "[pre-push] FAIL: .gitleaks.toml changed in the pushed range ($_lref) -- it can silently weaken or disable secret scanning" >&2
            echo "[pre-push]   Set LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE=1 to push this anyway." >&2
            _full_scan_failures=$((_full_scan_failures + 1))
        else
            echo "[pre-push]   LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE=1 set -- allowing the config change (full-push scan still uses the PRE-change config, not the tip's -- see below)." >&2
        fi
    fi

    _resolve_gitleaks_bin
    if [[ -z "$_gitleaks_bin" ]]; then
        if [[ "${LOKI_ALLOW_UNSCANNED_PUSH:-0}" == "1" ]]; then
            echo "[pre-push] WARNING: pinned gitleaks v${GITLEAKS_VERSION} not installed; LOKI_ALLOW_UNSCANNED_PUSH=1 set -- pushing $_lref WITHOUT the full-push secret scan." >&2
        else
            echo "[pre-push] FAIL: pinned gitleaks v${GITLEAKS_VERSION} is not installed -- cannot run the full-push secret scan for $_lref" >&2
            echo "[pre-push]   install it: scripts/install-gitleaks.sh" >&2
            echo "[pre-push]   or set LOKI_ALLOW_UNSCANNED_PUSH=1 to push anyway (rare)." >&2
            _full_scan_failures=$((_full_scan_failures + 1))
        fi
        continue
    fi

    [[ -n "$_full_scan_root" ]] || _full_scan_root="$(mktemp -d "${TMPDIR:-/tmp}/loki-prepush-full.XXXXXX")"
    if [[ -z "$_full_scan_clone" ]]; then
        _full_scan_clone="$_full_scan_root/full-scan.git"
        _full_git_common_dir="$(cd "$_top" && git rev-parse --git-common-dir)"
        case "$_full_git_common_dir" in
            /*) : ;;
            *) _full_git_common_dir="$_top/$_full_git_common_dir" ;;
        esac
        if ! git clone -q --mirror --shared "$_full_git_common_dir" "$_full_scan_clone" 2>/dev/null; then
            echo "[pre-push] FAIL: could not create the scan clone for the full-push secret scan" >&2
            _full_scan_failures=$((_full_scan_failures + 1))
            _full_scan_clone="__failed__"
        fi
    fi
    [[ "$_full_scan_clone" != "__failed__" ]] || continue

    # The PUSHED TIP's ($_lsha) .gitleaksignore, E-99 invariant: absent on the
    # tip, scan with an empty ignore file (errs strict, never open). The
    # ignore file is UNCHANGED by this defense-in-depth -- a narrower risk
    # than the config (it can only suppress fingerprinted findings gitleaks
    # already found, not disable the rules that find them), and E-99's tip-
    # trust design for it is deliberate (case 29: CI-parity for a merge
    # bringing in an old commit).
    _full_ignore_file="$_full_scan_root/full-scan.gitleaksignore"
    git -C "$_top" show "$_lsha:.gitleaksignore" > "$_full_ignore_file" 2>/dev/null || : > "$_full_ignore_file"
    _full_config_file="$_full_scan_root/full-scan.gitleaks.toml"
    _full_config_arg=()
    # Defense in depth (r2): if THIS push changed .gitleaks.toml, scan with
    # the config from BEFORE the push -- the base commit's, or main's when
    # there is no usable base (new branch / unfetched remote) -- never the
    # tip's. This holds even when LOKI_ALLOW_GITLEAKS_CONFIG_CHANGE=1
    # overrode the refusal above: the override lets the PUSH through, not
    # the attacker's config INTO the scan that is supposed to catch the
    # secret riding along with it.
    _full_config_source="$_lsha"
    if [[ -n "$_toml_changed_commits" ]]; then
        if [[ "$_full_base_is_empty" != "1" ]]; then
            _full_config_source="$_full_base"
        else
            _full_config_source="refs/remotes/${1:-origin}/main"
        fi
    fi
    if git -C "$_top" show "${_full_config_source}:.gitleaks.toml" > "$_full_config_file" 2>/dev/null; then
        _full_config_arg=(--config "$_full_config_file")
    fi

    # Same merge-diff mode CI's gitleaks gate uses (first-parent).
    echo "[pre-push] gitleaks git --log-opts=\"$_full_log_opts $_gitleaks_merge_mode\" ($_lref, every pushed path)"
    # bash 3.2 (macOS's /bin/bash): "${arr[@]}" on a genuinely empty array is
    # an unbound-variable error under `set -u`. ${arr[@]+"${arr[@]}"} is the
    # portable guard.
    if _full_out="$(${_gitleaks_timeout_prefix[@]+"${_gitleaks_timeout_prefix[@]}"} "$_gitleaks_bin" git "$_full_scan_clone" --log-opts="$_full_log_opts $_gitleaks_merge_mode" \
            ${_full_config_arg[@]+"${_full_config_arg[@]}"} \
            --gitleaks-ignore-path "$_full_ignore_file" --redact --no-banner -v 2>&1)"; then
        _full_gl_rc=0
    else
        _full_gl_rc=$?
    fi
    if [[ "$_full_gl_rc" == "1" ]]; then
        # Never the secret: --redact already masks it, and this filter keeps
        # only the location/rule lines even so.
        printf '%s\n' "$_full_out" | grep -E '^(File|Line|RuleID|Fingerprint|Commit):' >&2 || true
        echo "[pre-push] FAIL: gitleaks found a possible secret in the pushed commits (range $_full_log_opts, $_lref)" >&2
        echo "[pre-push]   Verify the finding above. If it is a false positive, add its exact" >&2
        echo "[pre-push]   Fingerprint (printed above) to .gitleaksignore with a one-line reason." >&2
        _full_scan_failures=$((_full_scan_failures + 1))
    elif [[ "$_full_gl_rc" != "0" ]]; then
        # Exit codes other than 0 (clean) and 1 (leaks found) are a scanner
        # failure, not a finding.
        echo "[pre-push] FAIL: gitleaks failed (exit $_full_gl_rc) scanning the pushed commits ($_lref)" >&2
        _full_scan_failures=$((_full_scan_failures + 1))
    fi
done <<< "$_stdin_refs"
if [[ $_full_scan_failures -gt 0 ]]; then
    echo "[pre-push] $_full_scan_failures full-push secret scan check(s) failed -- aborting push. PRE_PUSH_SKIP does not bypass this." >&2
    exit 1
fi

if [[ "${PRE_PUSH_SKIP:-0}" == "1" ]]; then
    echo "[pre-push] PRE_PUSH_SKIP=1 set, skipping"
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

failures=0

# --- Identity guard: never push to github.com under the Disney identity -------
# The global gitconfig defaults to murel002 (github.disney.com); a repo that
# forgot to set its local user.email would silently push commits authored as
# murel002 to github.com/asklokesh. Deterministic, no model, fires at the last
# gate before the identity reaches GitHub. Only enforces for github.com remotes
# (github.disney.com pushes legitimately use murel002 and are exempt).
remote_url="${2:-$(git remote get-url --push "${1:-origin}" 2>/dev/null || echo "")}"
if [[ "$remote_url" == *"github.com"* ]]; then
    id_email="$(git config user.email 2>/dev/null || echo "")"
    id_name="$(git config user.name 2>/dev/null || echo "")"
    if [[ "$id_email" != "lokeshmure@live.com" || "$id_name" != "asklokesh" ]]; then
        echo "[pre-push] FAIL: github.com push requires identity asklokesh <lokeshmure@live.com>" >&2
        echo "[pre-push]   current repo identity: ${id_name:-<unset>} <${id_email:-<unset>}>" >&2
        echo "[pre-push]   fix: git config user.name asklokesh && git config user.email lokeshmure@live.com" >&2
        failures=$((failures + 1))
    fi
fi

echo "[pre-push] bash -n autonomy/run.sh"
if ! bash -n autonomy/run.sh; then
    echo "[pre-push] FAIL: autonomy/run.sh has syntax errors" >&2
    failures=$((failures + 1))
fi

echo "[pre-push] bash -n autonomy/loki"
if ! bash -n autonomy/loki; then
    echo "[pre-push] FAIL: autonomy/loki has syntax errors" >&2
    failures=$((failures + 1))
fi

# --- Red-main guard ----------------------------------------------------------
# THE FAILURE THIS EXISTS FOR, measured 2026-07-30: main sat RED for THREE
# consecutive releases (v8.0.3, v8.1.0, and the commit before them) because
# nothing ever forced anyone to look. The red was reporting a GENUINE bug the
# whole time -- providers/opencode.sh silently dropped every caller-supplied
# flag -- and three releases shipped straight over it.
#
# A warning, not a block. Whether the tip is red is a fact about the PREVIOUS
# push, and the most common reason to push onto a red main is to FIX it, which
# a hard block would prevent. But it must be impossible to do accidentally: you
# now have to read the words "main is currently RED" before your push proceeds.
#
# Requires gh; silently skipped without it (an offline or gh-less machine still
# pushes normally, and CI remains the backstop).
if command -v gh >/dev/null 2>&1 && [[ "${PRE_PUSH_NO_CI_CHECK:-0}" != "1" ]]; then
    _tip_state=$(gh run list --branch main --workflow=Tests --limit 1 \
                    --json conclusion --jq '.[0].conclusion' 2>/dev/null || echo "")
    if [[ "$_tip_state" == "failure" ]]; then
        echo "[pre-push] ---------------------------------------------------" >&2
        echo "[pre-push] WARNING: main is currently RED (last Tests run failed)." >&2
        echo "[pre-push] If this push is not the fix, you are stacking work on" >&2
        echo "[pre-push] a broken tip -- that is how v8.0.3 through v8.1.0 shipped" >&2
        echo "[pre-push] over a real arg-dropping bug in the opencode provider." >&2
        echo "[pre-push]   gh run list --branch main --workflow=Tests --limit 1" >&2
        echo "[pre-push] ---------------------------------------------------" >&2
    fi
fi

if [[ $failures -gt 0 ]]; then
    echo "[pre-push] $failures check(s) failed -- aborting push" >&2
    echo "[pre-push] Re-run after fixing, or skip with PRE_PUSH_SKIP=1 git push" >&2
    exit 1
fi

echo "[pre-push] all checks passed"
