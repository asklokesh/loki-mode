{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomi.dev/schemas/outcome-contract/v0.1",
  "title": "Autonomi Outcome Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "intent", "acceptance", "executor", "verifier"],
  "properties": {
    "schema": {"const": "autonomi-outcome-contract/v0.1"},
    "id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "executor": {"$ref": "#/$defs/identity"},
    "verifier": {"$ref": "#/$defs/identity"},
    "constraints": {"type": "object"},
    "evidence": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["human", "agent", "service", "organization"]}
      }
    }
  }
}
