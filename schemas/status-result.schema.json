{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomi.dev/loki-mode/schemas/status-result.schema.json",
  "title": "loki status --json",
  "description": "Output of `loki status --json`. Exits 0 with this document, including when no run is active (status inactive).",
  "type": "object",
  "required": ["version", "status", "iteration", "provider", "task_counts"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string" },
    "phase": { "type": ["string", "null"] },
    "iteration": { "type": "integer", "minimum": 0 },
    "provider": { "type": "string" },
    "provider_source": { "type": "string" },
    "dashboard_url": { "type": ["string", "null"] },
    "pid": { "type": ["integer", "null"] },
    "elapsed_time": { "type": "number", "minimum": 0 },
    "task_counts": {
      "type": "object",
      "required": ["total", "completed", "failed", "pending"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "phase1": { "type": "object" }
  }
}
