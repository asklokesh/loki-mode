function _loki_start {
    # Rule: list every flag bin/loki routes (Bun/engine10 ones such as --model, --max-cost, --spec, --no-pr too), not only cmd_start's own.
    _arguments \
        '--provider[AI provider]:provider name:(claude cline codex aider opencode)' \
        '--parallel[Parallel mode]' \
        '--brief[Zero-config brief mode]:brief text:' \
        '--worktree[Git worktree isolation]' \
        '--pr[Worktree plus auto-create PR]' \
        '--ship[Worktree plus PR plus auto-merge]' \
        '--detach[Run in background (implies --worktree)]' \
        '--workspace[Run a loki.yaml workspace for the brief]:workspace name:' \
        '--deploy[Deploy after a VERIFIED run via loki deploy --execute]' \
        '--health-url[With --deploy: health probe URL]:url:' \
        '--auto-rollback[With --deploy: roll back on a failed health probe]' \
        '--destination[With --deploy: preview, staging or production]:destination:(preview staging production)' \
        '--canary[With --deploy: canary rollout]' \
        '--domain[With --deploy: attach this domain and prove TLS]:hostname:' \
        '--env-file[With --deploy: env file pushed to the provider]:file:_files' \
        '--background[Background mode]' \
        '--bg[Background mode]' \
        '--simple[Force simple complexity]' \
        '--complex[Force complex complexity]' \
        '--github[Enable GitHub issue import]' \
        '--no-dashboard[Disable web dashboard]' \
        '--sandbox[Run in Docker sandbox]' \
        '--skip-memory[Skip loading memory context]' \
        '--spec[Run against an edited spec file]:spec file:_files' \
        '--spec-first[Write an editable spec, then stop]' \
        '--dry-run[Validate flags and preflight, print provider, model and cap, spend nothing]' \
        '--resume[Resume an interrupted run at the stage it stopped in]::run id:' \
        '--fresh[Skip the offer to resume an interrupted or cancelled run]' \
        '--yes[Skip confirmation prompts]' \
        '-y[Skip confirmation prompts]' \
        '--budget[Cost budget limit in USD]:amount:' \
        '--cost[Opt-in cost profile]:profile:(lean off)' \
        '--model[Model or route override]:model:' \
        '--max-cost[Spend cap in USD]:amount:' \
        '--no-pr[Build and verify without opening a pull request]' \
        '--explain-route[Print the route without running]' \
        '--max-iterations[Max iterations]:number:' \
        '--attempts[Independent attempts in worktrees, 1-5]:number:(1 2 3 4 5)' \
        '*:spec file:_loki_spec_files'
}

# Bias spec completion toward the file shapes Loki accepts (.md/.json/.txt/
# .yaml/.yml), while still offering directories so the user can navigate into a
# subfolder. Mirrors the bash completion. Makes the most-common command
# tab-driven and typo-proof, cutting "PRD file not found" mistakes.
function _loki_spec_files {
    _alternative \
        'specs:spec file:_files -g "*.(md|json|txt|yaml|yml)"' \
        'dirs:directory:_files -/'
}

