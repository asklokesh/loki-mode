#compdef loki

function _loki {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_loki_commands' \
        '*::arg:->args'

    case $state in
        (args)
            case $line[1] in
                start|quick)
                    _loki_start
                    ;;
                council)
                    _loki_council
                    ;;
                compound)
                    _loki_compound
                    ;;
                provider)
                    _loki_provider
                    ;;
                memory)
                    _loki_memory
                    ;;
                plan)
                    _loki_plan
                    ;;
                export)
                    _arguments '--sarif[Write findings.sarif for a run]'
                    ;;
                tour)
                    _arguments '--live[Tiny real task, same as loki wow]'
                    ;;
                wow)
                    _arguments \
                        '--offline[Always show the offline sample]' \
                        '--dry-run[Print the plan, no model call]' \
                        '--keep[Keep the temp repo]' \
                        '--provider[Provider]:provider:(claude opencode codex cline aider)' \
                        '--max-cost[Hard per-run cap in USD]:usd:'
                    ;;
                try)
                    _arguments \
                        '--dry-run[Clone, print the task and estimate, no model call]' \
                        '--provider[Provider]:provider:(claude opencode codex cline aider)' \
                        '--max-cost[Hard per-run cap in USD]:usd:'
                    ;;
                control)
                    _arguments \
                        '--port[Port for the control plane server]:port:' \
                        '--json[Output as JSON]' \
                        '--repo[Repository to backfill]:repo:_files -/' \
                        '1:subcommand:(serve status help)'
                    ;;
                config)
                    _loki_config
                    ;;
                dashboard)
                    _loki_dashboard
                    ;;
                sandbox)
                    _loki_sandbox
                    ;;
                notify)
                    _loki_notify
                    ;;
                enterprise)
                    _loki_enterprise
                    ;;
                projects)
                    _loki_projects
                    ;;
                telemetry)
                    _loki_telemetry
                    ;;
                agent)
                    _loki_agent
                    ;;
                cost)
                    _arguments \
                        '--json[Output machine-readable JSON]' \
                        '--last[Show only the last N runs]:count:' \
                        '--month[Only runs generated in that month]:month (YYYY-MM):' \
                        '--csv[One CSV row per run]' \
                        '--detail[Per-iteration cache and trend breakdown]' \
                        '--help[Show help]'
                    ;;
                next)
                    _arguments \
                        '--yes[Skip the confirmation prompt]' \
                        '--dry-run[Show what would run without running it]' \
                        '--suggest[With no active run, propose up to 3 small tasks]' \
                        '--json[Output machine-readable JSON]' \
                        '--help[Show help]'
                    ;;
                estimate)
                    _arguments \
                        '--json[Output machine-readable JSON]' \
                        '--model[Model whose rough prior to use]:model:' \
                        '--provider[Provider whose default model is used]:provider:' \
                        '--help[Show help]'
                    ;;
                status)
                    _arguments \
                        '--json[Output machine-readable JSON]' \
                        '--badge[Print verified deploy badge]' \
                        '--probe[Re-probe last deploy health URL]' \
                        '--follow[Print one line per run event until the run ends]' \
                        '--help[Show help]'
                    ;;
                doctor)
                    _arguments \
                        '--json[Output machine-readable JSON]' \
                        '(-q --quiet)'{-q,--quiet}'[Print only failed and warned checks plus the summary]' \
                        '--fix[Create state dirs and a default config; offer claude install and login]' \
                        '--yes[With --fix: run the claude install and login without asking]' \
                        '--help[Show help]'
                    ;;
                chat)
                    _arguments \
                        '--attach[Attach to a running session]' \
                        '--tui[Use the terminal UI]' \
                        '--help[Show help]'
                    ;;
                agents)
                    _arguments \
                        '1:subcommand:(list new show export)' \
                        '--claude[Export to .claude/agents]' \
                        '--user[Use the user-level agents directory]' \
                        '--help[Show help]'
                    ;;
                models)
                    _arguments \
                        '--local[Show local models]' \
                        '--json[Output machine-readable JSON]' \
                        '--help[Show help]'
                    ;;
                setup)
                    _arguments \
                        '--yes[Non-interactive defaults]' \
                        '--check[Report only]' \
                        '--help[Show help]'
                    ;;
                route)
                    _arguments \
                        '1:verb:(start quick)' \
                        '--json[Output machine-readable JSON]' \
                        '--provider[AI provider]:provider name:(claude cline codex aider opencode)' \
                        '--model[Model or route override]:model:' \
                        '--no-pr[Skip the pull request]' \
                        '--max-cost[Spend cap in USD]:amount:' \
                        '--help[Show help]'
                    ;;
                edit)
                    _arguments \
                        '--verify[Run verification after the edit]' \
                        '--commit[Commit the edit]' \
                        '--dry-run[Describe the change only]' \
                        '--help[Show help]' \
                        '*:file:_files'
                    ;;
                reset)
                    _loki_reset
                    ;;
                logs)
                    _arguments \
                        '--follow[Follow logs in real-time]' \
                        '-f[Follow logs in real-time]' \
                        '--tail[Number of lines to show]:number:' \
                        '-n[Number of lines to show]:number:' \
                        '--all[Show all lines]' \
                        '-a[Show all lines]' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
                issue)
                    _loki_issue
                    ;;
                metrics)
                    _arguments \
                        '--json[Machine-readable JSON output]' \
                        '--last[Analyze last N sessions]:number:' \
                        '--save[Write report to METRICS.md]' \
                        '--share[Upload report as a secret GitHub Gist]' \
                        '--public[With --share, create a PUBLIC gist]' \
                        '--help[Show help]' \
                        '1:subcommand:(prometheus)'
                    ;;
                report)
                    _arguments \
                        '--json[Machine-readable JSON output]' \
                        '--since[Window for kpis (Nd or YYYY-MM-DD)]:since:' \
                        '--efficiency[Include efficiency totals]' \
                        '--help[Show help]' \
                        '1:subcommand:(session metrics cost kpis export share dogfood release-notes)'
                    ;;
                share)
                    _arguments \
                        '--public[Create a PUBLIC gist, visible to anyone with the URL]' \
                        '--private[Create a secret gist (default)]' \
                        '--format[Report format]:format:(text markdown html)' \
                        '--help[Show help]'
                    ;;
                proof)
                    _arguments \
                        '--yes[Skip redaction-preview confirmation]' \
                        '--public[Create a PUBLIC gist when sharing]' \
                        '--private[Create a secret gist when sharing (default)]' \
                        '--hosted[Hosted publishing (coming in R9)]' \
                        '--dry-run[Scan and list what share would publish; publishes nothing]' \
                        '--help[Show help]' \
                        '1:subcommand:(list show open share badge md bundle)'
                    ;;
                completions)
                    _arguments '1:shell:(bash zsh install)'
                    ;;
                version)
                    _arguments '--json[Print version, runtime and install path as JSON]' '--help[Show help]'
                    ;;
                monitor)
                    _directories
                    ;;
                context|ctx)
                    _loki_context
                    ;;
                code)
                    _loki_code
                    ;;
                github)
                    _arguments \
                        '1:subcommand:(status sync export pr publish protect)' \
                        '--dry-run[protect: show the branch-protection read, change nothing]' \
                        '--off[protect: restore the saved branch protection]' \
                        '--public[publish: create a public repository]' \
                        '--private[publish: create a private repository]' \
                        '--dir[publish: project directory]:directory:_directories'
                    ;;
                deploy)
                    _arguments \
                        '--dir[Project directory to scan]:directory:_directories' \
                        '--no-clip[Do not copy the command to the clipboard]' \
                        '--execute[Run the deploy command if the receipt gate passes]' \
                        '--canary[With --execute: staged rollout (Vercel promote, Fly canary)]' \
                        '--env-file[With --execute: push KEY=VALUE env via Vercel, Fly, Netlify or Cloudflare (names-only record)]:env file:_files' \
                        '--domain[With --execute: attach a custom domain and prove TLS with openssl]:hostname:' \
                        '--allow-unanchored[Proceed when the receipt records no baseline]' \
                        '--health-url[Health probe URL]:url:' \
                        '--auto-rollback[Roll back on a failed health probe]' \
                        '--help[Show help]'
                    ;;
                verify-pr)
                    _arguments \
                        '--out[Result directory]:dir:_files -/' \
                        '--json[Print the verdict object on stdout]' \
                        '--help[Show help]'
                    ;;
                verify)
                    _arguments \
                        '--pubkey[Check against this public key only]:key file:_files' \
                        '--sign-deploy[Sign a loki.deploy/1 deploy record in place]:record:_files' \
                        '--sign-provenance[Sign a loki.provenance/1 doc in place]:doc:_files' \
                        '--url[Verify the live provenance doc served at URL]:url:' \
                        '--expect-sha[Require the provenance head_sha to equal SHA]:sha:' \
                        '--receipt[Cited receipt file for a deploy record]:receipt:_files' \
                        '--max-age[Reject a receipt older than DUR]:duration:' \
                        '--require-exogenous[Exit 4 when a VERIFIED receipt has no agent-independent passing check]' \
                        '--explain[List each gate as exogenous or agent-influenced with the evidence it read]' \
                        '--json[Print the verdict and gates as JSON on stdout]' \
                        '--seal-composite[Sign a workspace composite]:run dir:_directories' \
                        '--fast[Deterministic checks only: no model call, no network]' \
                        '--path[With --fast: repo root to check]:dir:_directories' \
                        '--diff-base[With --fast: scope the checks to the diff against REF]:ref:' \
                        '--no-cache[With --fast: ignore the result cache]' \
                        '--help[Show help]' \
                        '*:receipt or deploy record:_files'
                    ;;
            esac
            ;;
    esac
}

