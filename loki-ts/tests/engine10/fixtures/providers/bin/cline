#!/usr/bin/env bash
# Stub cline CLI for E-37 (engine10 non-claude provider paths). Never touches
# real codex: exists so the implement session has a real binary to spawn.
# Dumps its own env (STUB_ENV_LOG) so the test can assert LOKI_HOST_GUARD is
# absent, then appends multiply() to calc.ts once so implement sees a diff.
set -u
if [ -n "${STUB_ENV_LOG:-}" ]; then env > "$STUB_ENV_LOG"; fi
if [ -n "${STUB_ARGV_LOG:-}" ]; then printf '%s\n' "$@" >> "$STUB_ARGV_LOG"; fi
printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts
exit 0
