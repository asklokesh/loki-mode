#!/usr/bin/env bash
# Stub claude CLI for the issue-ref e2e test (E-47). The implement session
# adds subtract() to calc.ts and reports done. Every -p call appends its stage
# name and, for implement, whether the brief carried the issue title/body and
# GH_TOKEN, to log files (kept outside the repo).
set -u
if [ "${1:-}" = "--help" ]; then
  echo "Usage: claude [options] -p <prompt>"
  echo "  --dangerously-skip-permissions --model <m> --settings <json> -p, --print"
  exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then # TEN-STABILITY-09: the P9 login probe reads this; never logged as a stage
  echo '{"loggedIn":true}'
  exit 0
fi
prompt=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-p" ]; then prompt="${2:-}"; shift; fi
  shift
done
case "$prompt" in
  *"Loki 10 Wall author"*) stage=wall ;;
  *"Loki 10 plan stage"*) stage=plan ;;
  *"Loki 10 implement stage"*) stage=implement ;;
  *) stage=other ;;
esac
if [ -n "${ISSUE_REF_STUB_LOG:-}" ]; then echo "$stage" >> "$ISSUE_REF_STUB_LOG"; fi
# Journey seam: while $ISSUE_REF_STUB_HANG_DIR/hang-<stage> exists, announce this process and block (the test kill -9s the run here).
if [ -n "${ISSUE_REF_STUB_HANG_DIR:-}" ] && [ -f "${ISSUE_REF_STUB_HANG_DIR}/hang-${stage}" ]; then
  echo "$$" > "${ISSUE_REF_STUB_HANG_DIR}/pid.tmp" && mv "${ISSUE_REF_STUB_HANG_DIR}/pid.tmp" "${ISSUE_REF_STUB_HANG_DIR}/pid" # atomic: the test must never read a half-written pid
  while [ -f "${ISSUE_REF_STUB_HANG_DIR}/hang-${stage}" ]; do sleep 0.2; done
fi
if [ "$stage" = "plan" ] && [ -n "${ISSUE_REF_STUB_PLAN_BRIEF_LOG:-}" ]; then printf '%s' "$prompt" > "$ISSUE_REF_STUB_PLAN_BRIEF_LOG"; fi
if [ -n "${ISSUE_REF_STUB_ENV_LOG:-}" ]; then
  echo "$stage GH_TOKEN=${GH_TOKEN:-}" >> "$ISSUE_REF_STUB_ENV_LOG"
fi
if [ "$stage" = "wall" ]; then
  # Wall author (runs in its own scratch dir): one acceptance check that fails on base and passes once subtract() exists.
  printf 'import { expect, test } from "bun:test";\nimport { subtract } from "./calc";\n\ntest("wall subtract", () => {\n  expect(subtract(5, 3)).toBe(2);\n});\n' > loki_wall_subtract.test.ts
  echo "LOKI_DONE"
fi
if [ "$stage" = "implement" ]; then
  if [ -n "${ISSUE_REF_STUB_BRIEF_LOG:-}" ]; then printf '%s' "$prompt" > "$ISSUE_REF_STUB_BRIEF_LOG"; fi
  # PG-31 seam: raise a spec conflict until the brief carries the operator's answer.
  if [ -n "${ISSUE_REF_STUB_CONFLICT:-}" ]; then
    case "$prompt" in *"Clarification answering"*) ;; *) echo "LOKI_SPEC_CONFLICT: should subtract clamp at zero?"; exit 0 ;; esac
  fi
  printf '\nexport function subtract(a: number, b: number): number {\n  return a - b;\n}\n' >> calc.ts
  echo "LOKI_DONE"
fi
exit 0
