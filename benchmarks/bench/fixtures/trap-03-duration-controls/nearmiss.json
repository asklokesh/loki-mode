    "case": "units-in-any-order",
    "kind": "ordering",
    "source": "import re\n\n_SECONDS = {\"d\": 86400, \"h\": 3600, \"m\": 60, \"s\": 1}\n\n\ndef parse_duration(s):\n    if not s or not re.fullmatch(r\"(?:[0-9]+[dhms])+\", s):\n        raise ValueError(\"invalid duration: %r\" % (s,))\n    units = re.findall(r\"([0-9]+)([dhms])\", s)\n    if len({u for _, u in units}) != len(units):\n        raise ValueError(\"duplicate unit\")\n    return sum(int(n) * _SECONDS[u] for n, u in units)\n",
    "file": "duration.py"
  }
