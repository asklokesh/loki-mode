{
 "what": "systematic-edit completer (proto/systematic-edit-recall) replayed on real merged multi-site edits from repos outside the corpus; no model calls",
 "protocol": {
  "ground_truth": ">= 3 one-line rewrites in one commit's non-test code diff with one identical change bag (tokens only the old line has, tokens only the new line has)",
  "loo": "one site reverted to the parent's text at a time (first, middle, last per cluster), every other change of the commit applied",
  "keep2": "only the first 2 sites kept, every other site of the cluster reverted",
  "caps": "at most 3 clusters per commit (first in diff order); last 1500 non-merge commits of each clone (depth 3000)",
  "dev_repos": [
   "spf13/cobra",
   "psf/requests",
   "honojs/hono"
  ],
  "test_repos_blind": [
   "gin-gonic/gin",
   "stretchr/testify",
   "encode/httpx",
   "python-attrs/attrs",
   "typeorm/typeorm",
   "mobxjs/mobx"
  ],
  "test_sample": "30 commits per test repo (seed 2026) among commits with a cluster site in a file of >= 300 lines; policy fixed in code before the test replay",
  "scored": "a rewrite is correct only when its tokens equal the merged commit's line at a held-out site; any other rewrite is wrong",
  "policy_prod": "ctx 2, scope file, fan-out 1 (a rule may rewrite at most as many lines as it learned from), lgg + carried-generalized levels, affix guard, no task-name filter"
 },
