if [ "$stage" = "implement" ] && [ -n "${E2E_STUB_NOFINISH:-}" ]; then # S1b (tests/min/scope-and-fix.sh): the implement reply has no finish line, as FireLater#24 Haiku's compacted session did
  if printf '%s' "$prompt" | grep -q "Any earlier request to stop and write a text-only summary is over"; then # a continue (util/conflict_resume.ts continueBrief)
    case "$E2E_STUB_NOFINISH" in
      once) printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts; echo "LOKI_DONE"; exit 0 ;; # finishes on the first continue
      never) printf '// continue pass %s\n' "$$-$RANDOM" >> calc.ts; echo "Progress made. Still outstanding: the docs for multiply."; exit 0 ;; # changes the tree, never finishes
      still) echo "Still outstanding: the docs for multiply."; exit 0 ;; # changes nothing, never finishes
      unfinished) echo "I could not write the docs here."; echo "LOKI_UNFINISHED: the docs for multiply are not written"; exit 0 ;; # candidate 1: the named ending, again, with no change
      conflict|conflictcited) printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts; echo "LOKI_DONE"; exit 0 ;; # H1: the continue finishes the work
    esac
  fi
  if [ "$E2E_STUB_NOFINISH" = once ]; then printf '\n// multiply() pending\n' >> calc.ts; else printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts; fi
  if [ "$E2E_STUB_NOFINISH" = unfinished ]; then echo "multiply() is done."; echo "LOKI_UNFINISHED: the docs for multiply are not written"; exit 0; fi
  if [ "$E2E_STUB_NOFINISH" = conflict ]; then echo "LOKI_SPEC_CONFLICT: stage incomplete. multiply() is not implemented yet; no conflicting test was found."; exit 0; fi # H1: a conflict that cites no test
  if [ "$E2E_STUB_NOFINISH" = conflictcited ]; then echo "LOKI_SPEC_CONFLICT: calc.test.ts:3 asserts add(2, 2) is 5, which contradicts the task"; exit 0; fi # H1: a conflict that cites a test
  echo "Context was compacted. Summary of progress."; echo "**Result:** LOKI_BLOCKED: the docs for multiply and the impacted test runs are still outstanding."; exit 0
fi
if [ "$stage" = "implement" ] && [ "${E2E_STUB_MODE:-done}" != "coverage" ] && printf '%s' "$prompt" | grep -q "List each site, symbol, example or case"; then
  echo "LOKI_DONE"; exit 0 # the coverage turn (LOKI_E10_COVERAGE_RESUME=1) on a change the first turn completed: a real model edits nothing; replaying the first turn's edit would duplicate it
