  if [ -n "${E2E_STUB_REVIEW:-}" ]; then printf '{"type":"result","result":"VERDICT: %s\\n- stub reviewer concern%s","total_cost_usd":0.01}\n' "$E2E_STUB_REVIEW" "${E2E_STUB_REVIEW_EXTRA:+\\n- $E2E_STUB_REVIEW_EXTRA}"; fi # E2E_STUB_REVIEW_EXTRA: one more reason line (F3 UNMET legs)
  exit 0
