if [ "$stage" = "implement" ] && [ -n "${E2E_STUB_RV:-}" ] && printf '%s' "$prompt" | grep -q "Pre-delivery review\. Before this change"; then # TG legs: the -rv review turn adds a test to calc.test.ts
  if [ -n "${E2E_STUB_RV_LOG:-}" ]; then printf '%s' "$prompt" > "$E2E_STUB_RV_LOG"; printf '%s\n' "$flags" > "$E2E_STUB_RV_LOG.flags"; fi # VF legs: the review turn's whole prompt and its CLI flags
  case "$E2E_STUB_RV" in # breaktest: the added test comes with a beforeEach hook that turns the existing add test red; goodtest: a plain passing test
    breaktest) printf '%s\n' '' 'import { beforeEach } from "bun:test";' 'beforeEach(() => { expect(calc.add(2, 3)).toBe(6); });' 'test("add twice", () => { expect(calc.add(calc.add(1, 1), 1)).toBe(3); });' >> calc.test.ts ;;
    goodtest) printf '%s\n' '' 'test("add twice", () => { expect(calc.add(calc.add(1, 1), 1)).toBe(3); });' >> calc.test.ts ;;
  esac
  echo "LOKI_DONE"; exit 0
