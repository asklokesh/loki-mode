#!/usr/bin/env bash
# Stub claude CLI for the engine10 e2e test. Modes via E2E_STUB_MODE:
#   done (default): the implement session appends multiply() to calc.ts
#   already: the implement session changes nothing and claims already-done
#   alreadyfirst: the first implement session claims already-done; the already-done challenge resume makes the multiply() change
#   emptythenalready: LOKI_DONE with no change, LOKI_ALREADY_DONE in reply to the empty-done correction, the change on the challenge
#   editalready: adds multiply() and answers LOKI_ALREADY_DONE every time
#   redothenempty: claims already-done; on the router's redo (REDO_CHALLENGE) LOKI_DONE with no change; already-done again on the empty-done correction
#   slice: the implement session appends slice_<id>() for the "Slice <id> of N" it was given (tests/min/decompose-and-intake.sh)
#   coverage: multiply() and subtract() on the first turn; negate() only when the prompt carries the coverage brief, or all three on a first turn whose brief carries the folded coverage line (tests/min/scope-and-fix.sh, LOKI_E10_COVERAGE_RESUME)
#   wrong: the implement session appends a multiply() that adds (calc.test.ts then fails)
#   attempts: EXP-0010 (tests/min/engine10-e2e-stub.sh). Every implement session writes a wrong multiply() (calc.ts, or calc.py when the repo has one) except
#     the session running in <temp>/loki-attempts-<random>/B<n> where n is E2E_STUB_RIGHT (unset or none: every session is wrong; the primary is attempt 0);
#     E2E_STUB_NEWFILE=1: every session also creates new_<n>.<ext> and shared_new.<ext> (a file only that attempt owns, and one every attempt creates);
#     E2E_STUB_WEAKEN=<n>: that attempt drops the multiply assertion from calc.test.ts instead of fixing multiply()
#   agentonly: multiply() plus an exported square() that only the session's own square.test.ts calls (tests/min/scope-and-fix.sh)
#   viacaller: multiply() plus an exported scale() that only the untouched ops.ts calls (tests/min/scope-and-fix.sh seeds ops.ts and its test)
#   wallphantom: the Wall author writes loki_wall_multiply.test.ts calling multiplyAll(), a name the task never asks for
#     (red on base, still red after the correct multiply() lands); E2E_STUB_WALL_SLEEP=<s> makes that author session slow
# E2E_STUB_WALL (Wall author, any mode): gopkg writes loki_wall_calc_test.go as "package calc" (the tests/ directory is
#   "package tests"); rsnew writes loki_wall_calc.rs calling Calc::new() where the crate defines Calc::new(base); rsbase writes a
#   correct test calling Calc::new(5) for a task that changes Calc::new() to Calc::new(base) (tests/min/scope-and-fix.sh); vitestred writes a vitest
#   loki_wall_search.test.ts whose C3 never passes and whose C2 passes once the hook file says ts_rank (E2E_STUB_FIX=rank adds it) (tests/min/run-safety.sh: a Wall-only failure is delivered as PARTIAL)
# E2E_STUB_TEST_EDIT=1: the implement session weakens calc.test.ts (adds a test.skip) and adds a new multiply.test.ts;
# =update only appends a test case to calc.test.ts (assertions kept), plus the same new file; =mock adds a vi.mock call and =beforeeach a beforeEach hook (no case, no assertion lost); =delete only drops the add(2, 3) assertion (no case added back, which the count heuristic would offset).
# E2E_STUB_SCOPE_EDIT=1: the implement session also edits util.ts (when the repo has one).
# E2E_STUB_BREAK_CFG=1: it also writes {"ok": false} to cfg.json (when the repo has one); E2E_STUB_LINTBAD=1: it also writes a tool.sh
# that fails bash -n. Fix modes: cfgfirst fixes cfg.json first, multiply() next; linttwice leaves tool.sh broken in a new way once, then fixes it.
# E2E_STUB_FIX (fix sessions, told apart by LOKI_E10_STAGE=fix): conflict answers LOKI_SPEC_CONFLICT and edits
# nothing; wallconflict does the same citing loki_wall_multiply.test.ts; noprogress edits calc.ts without fixing multiply();
# fixit turns the wrong multiply() right; twostep needs two rounds. E2E_STUB_ITER_LOG gets "<stage> <iteration> <prompt bytes>"
# per call; E2E_STUB_USAGE=<n> records n output tokens per session (input = prompt bytes / 4) as the session's cost.
# E2E_STUB_REVIEW=PASS|FLAG|BLOCK: the seal cross-review session replies with that verdict (tests/min/engine10-e2e-stub.sh).
#   overlay: a plain `-p <task>` call copies E2E_STUB_OVERLAY over the cwd (h2h benchmark harness)
# E2E_STUB_SLEEP=<s>: the implement session sleeps after its edit, so a test can signal the run mid-session (tests/min/run-safety.sh).
# E2E_STUB_SPLIT (JSON text): the MASS-2 split planning session writes it to the file its brief names.
# E2E_STUB_SPEC_REPLY (text): the exec-spec generator session (its brief names spec_reply.md, LOKI_E10_EXEC_SPEC) writes it there.
# E2E_STUB_IMPL_CONFLICT=<text>: an implement session not on sonnet answers LOKI_SPEC_CONFLICT: <text>; on sonnet it implements.
# E2E_STUB_ROUTE_LOG gets "<LOKI_E10_STAGE> <iteration> model=<--model> advisor=<advisorModel> wall=<0|1>" per call.
# Every -p call appends its stage name to E2E_STUB_LOG (kept outside the repo); E2E_STUB_BUDGET_LOG gets its LOKI_BUDGET_LIMIT and LEDGER.
set -u
if [ "${1:-}" = "--help" ]; then
  echo "Usage: claude [options] -p <prompt>"
  echo "  --dangerously-skip-permissions --model <m> --settings <json> -p, --print"
  exit 0
fi
if [ "${1:-}" = "--version" ]; then # the advisor probe (providers.ts installedClaudeCodeVersion) reads this; a version call is not a session
  echo "2.1.316 (Claude Code)"
  exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then # TEN-STABILITY-09: the P9 login probe in preflight reads this
  echo '{"loggedIn":true}'
  exit 0
fi
prompt=""; flags=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-p" ]; then prompt="${2:-}"; shift; else flags="$flags $1"; fi
  shift
done
case "$prompt" in
  "Loki attempts review"*) stage=attemptsreview ;; # LOKI_E10_ATTEMPTS: the tool-less tie review (features/attempts.ts reviewTie); before every other match, the diffs it quotes can hold any text
  *"Loki remedy check"*) stage=remedy ;; # F1 LOKI_E10_RANKED_REMEDY: the tool-less check of the diff against the first-ranked remedy (util/conflict_resume.ts)
  *"Loki Opus consult"*) stage=consult ;; # LOKI_E10_OPUS_CONSULT: the tool-less consult call (features/opus_consult.ts)
  *"implement stage in patch mode"*) stage=patch ;; # LOKI_E10_PATCH: the tool-less patch call (features/patch_protocol.ts), before the implement match
  *"code reviewer"*) stage=review ;; # any model review session: the seal cross-review, or a post-PR reviewer
  *"Loki 10 plan stage"*) stage=plan ;;
  *"Loki 10 implement stage"*) stage=implement ;;
  *) stage=other ;;
esac
is_wall=0; case "$prompt" in *"Loki 10 Wall author"*) is_wall=1 ;; esac
# One locked append per call: the argv line is several KB (the secret deny rules), and parallel stage calls
# (plan beside wall) would otherwise interleave their writes into broken lines.
if [ -n "${E2E_STUB_ARGV_LOG:-}" ]; then
  lock="$E2E_STUB_ARGV_LOG.lock"; n=0
  until mkdir "$lock" 2>/dev/null; do n=$((n + 1)); [ "$n" -gt 500 ] && break; sleep 0.01; done
  echo "$stage$flags" >> "$E2E_STUB_ARGV_LOG"
  rmdir "$lock" 2>/dev/null || true
fi
if [ "$stage" = patch ] && [ -z "${E2E_STUB_PATCH:-}" ]; then # default-on patch call with no scripted patch: a priced, edit-free conflict reply, so the protocol restores nothing and today's agentic session runs (no log line: legs that count sessions see today's sessions)
  echo '{"type":"result","subtype":"success","is_error":false,"result":"LOKI_SPEC_CONFLICT: the stub writes no patch unless E2E_STUB_PATCH is set","total_cost_usd":0,"usage":{"input_tokens":0,"output_tokens":0}}'
  exit 0
fi
if [ -n "${E2E_STUB_LOG:-}" ]; then echo "$stage" >> "$E2E_STUB_LOG"; fi
if [ -n "${E2E_STUB_ROUTE_LOG:-}" ]; then # one line per session: engine stage, iteration, --model value, advisorModel from --settings (tests/min/auto-route.sh)
  r_model="$(printf '%s' "$flags" | grep -o -- '--model [^ ]*' | head -1 | cut -d' ' -f2)"
  r_adv="$(printf '%s' "$flags" | grep -o '"advisorModel":"[^"]*"' | head -1 | cut -d'"' -f4)"
  r_win="$(printf '%s' "$flags" | grep -o '"autoCompactWindow":[0-9]*' | head -1 | cut -d: -f2)"
  echo "${LOKI_E10_STAGE:-none} ${LOKI_ITERATION:-none} model=${r_model:-none} advisor=${r_adv:-none} wall=$is_wall window=${r_win:-none}" >> "$E2E_STUB_ROUTE_LOG"
fi
if [ -n "${E2E_STUB_BUDGET_LOG:-}" ]; then echo "$stage limit=${LOKI_BUDGET_LIMIT:-} ledger=${LOKI_BUDGET_LEDGER:-}" >> "$E2E_STUB_BUDGET_LOG"; fi
if [ -n "${E2E_STUB_PROMPT_LOG:-}" ]; then printf '%s\n' "$prompt" >> "$E2E_STUB_PROMPT_LOG.$stage$is_wall"; fi # CW-12: the full prompt of every call, one file per stage (wall prompts land in .other1)
# What the session can see: the canary test asserts no GitHub token and no LOKI_LEGACY_BASH.
if [ -n "${E2E_STUB_ENV_LOG:-}" ]; then echo "$stage GH_TOKEN=${GH_TOKEN:-} LOKI_LEGACY_BASH=${LOKI_LEGACY_BASH:-} SEAL_PATCH=${LOKI_E10_SEAL_EXISTING_PATCH:-}" >> "$E2E_STUB_ENV_LOG"; fi
if [ -n "${E2E_STUB_ITER_LOG:-}" ]; then echo "${LOKI_E10_STAGE:-none} ${LOKI_ITERATION:-none} ${#prompt}" >> "$E2E_STUB_ITER_LOG"; fi
if [ -n "${E2E_STUB_USAGE:-}" ] && [ -n "${LOKI_ITERATION:-}" ]; then
  mkdir -p .loki/metrics
  printf '{"total_cost_usd":0.01,"input_tokens":%s,"output_tokens":%s,"cache_read_tokens":0,"cache_creation_tokens":0,"model":"stub","source":"e2e-stub"}\n' "$(( ${#prompt} / 4 ))" "$E2E_STUB_USAGE" > ".loki/metrics/result-cost-$LOKI_ITERATION.json"
fi
if [ -n "${E2E_STUB_SPEC_REPLY:-}" ]; then case "$prompt" in *"to the file spec_reply.md in the current directory"*) printf '%s\n' "$E2E_STUB_SPEC_REPLY" > spec_reply.md; echo "LOKI_DONE"; exit 0 ;; esac; fi
if [ "$stage" = attemptsreview ]; then # E2E_STUB_PICK=<letter>: the review picks that candidate (default: no PICK line, so the tie keeps the lowest index)
  printf '{"type":"result","subtype":"success","is_error":false,"result":"stub review%s","total_cost_usd":0.001,"usage":{"input_tokens":100,"output_tokens":5}}\n' "${E2E_STUB_PICK:+\\nPICK: $E2E_STUB_PICK}"
  exit 0
fi
if [ "$stage" = remedy ]; then # E2E_STUB_REMEDY=missing: the check says the remedy is not in the diff; else IMPLEMENTED
  word=IMPLEMENTED; [ "${E2E_STUB_REMEDY:-}" = missing ] && word=MISSING
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","total_cost_usd":0.0004,"usage":{"input_tokens":900,"output_tokens":2}}\n' "$word"
  exit 0
fi
if [ "$stage" = consult ]; then # E2E_STUB_CONSULT=fail: an error reply (no advice); else a priced diagnosis naming the intended behavior
  if [ "${E2E_STUB_CONSULT:-}" = "fail" ]; then echo '{"type":"result","subtype":"error_during_execution","is_error":true,"total_cost_usd":0.002,"usage":{"input_tokens":10,"output_tokens":0}}'; exit 0; fi
  echo '{"type":"result","subtype":"success","is_error":false,"result":"DIAGNOSIS: multiply adds instead of multiplying.\nINTENDED: STUB_ADVICE multiply(a, b) returns a * b.","total_cost_usd":0.002,"usage":{"input_tokens":100,"output_tokens":20}}'
  exit 0
fi
if [ "$stage" = patch ]; then # E2E_STUB_PATCH: green appends a right multiply(); repair writes a wrong one first and fixes it in the repair call;
  # wrongtwice stays wrong (the agentic session then runs); cfg also edits bunfig.toml (refused), the repair call leaves it out;
  # a green tree with no test gets the test-only repair: the stub adds a multiply test (notest: answers with no edit, the green tree is kept)
  MUL_OK='FILE: calc.ts\n<<<<<<< SEARCH\n=======\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n>>>>>>> REPLACE\n'
  MUL_BAD='FILE: calc.ts\n<<<<<<< SEARCH\n=======\nexport function multiply(a: number, b: number): number {\n  return a + b;\n}\n>>>>>>> REPLACE\n'
  CFG='FILE: bunfig.toml\n<<<<<<< SEARCH\n=======\n[test]\nroot = "."\n>>>>>>> REPLACE\n'
  FIXB='FILE: calc.ts\n<<<<<<< SEARCH\nexport function multiply(a: number, b: number): number {\n  return a + b;\n=======\nexport function multiply(a: number, b: number): number {\n  return a * b;\n>>>>>>> REPLACE\n'
  TESTB='FILE: calc.test.ts\n<<<<<<< SEARCH\n=======\n\ntest("multiply", () => {\n  expect((calc as unknown as { multiply: (a: number, b: number) => number }).multiply(2, 5)).toBe(10);\n});\n>>>>>>> REPLACE\n'
  repair=0; case "$prompt" in *"add no regression test"*) repair=t ;; *"Your earlier reply:"*) repair=1 ;; esac
  [ "$repair" = t ] && [ "${E2E_STUB_PATCH:-green}" != notest ] && { body="$TESTB"; repair=done; }
  case "${E2E_STUB_PATCH:-green}:$repair" in
    *:done) ;;
    notest:t) body="" ;;
    notest:*) body="$MUL_OK" ;;
    green:*|cfg:1) body="$MUL_OK" ;;
    repair:0|wrongtwice:*) body="$MUL_BAD" ;;
    repair:1) body="$FIXB" ;;
    cfg:0) body="$CFG$MUL_OK" ;;
    *) body="LOKI_SPEC_CONFLICT: stub" ;;
  esac
  python3 -I -c 'import json,sys; print(json.dumps({"type":"result","subtype":"success","is_error":False,"result":"stub patch\n"+sys.argv[1].encode().decode("unicode_escape")+"LOKI_DONE","total_cost_usd":0.001,"usage":{"input_tokens":10,"output_tokens":20}}))' "$body"
  exit 0
fi
if [ "${LOKI_E10_STAGE:-}" = "fix" ]; then # before the implement branch: a fix brief also carries the implement rules text
  case "${E2E_STUB_FIX:-}" in
    conflict) echo "LOKI_SPEC_CONFLICT: calc.test.ts:7 expects multiply(3, 4) to be 12"; exit 0 ;;
    prered) echo "LOKI_SPEC_CONFLICT: the named failures exist identically on clean HEAD (2 failing tests in both trees); they pre-exist on base and come from tests asserting old classes"; exit 0 ;; # fl24: FireLater#24's fix-round stop
    wallconflict) echo "LOKI_SPEC_CONFLICT: loki_wall_multiply.test.ts:5 calls multiplyAll, which the task never asks for"; exit 0 ;;
    consultfix) if printf '%s' "$prompt" | grep -q "STUB_ADVICE"; then python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; echo "ASSUMPTION: the reviewer says multiply means a * b"; else printf '// stub fix pass\n' >> calc.ts; fi; echo "LOKI_DONE"; exit 0 ;; # LOKI_E10_OPUS_CONSULT: only the consult advice fixes multiply()
    nsconflict) if printf '%s' "$prompt" | grep -q "Do not stop on this conflict"; then python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; echo "ASSUMPTION: multiply means a * b"; echo "LOKI_DONE"; else echo "LOKI_SPEC_CONFLICT: calc.test.ts:7 expects multiply(3, 4) to be 12"; fi; exit 0 ;; # never-stop: a conflict until the never-stop brief
    noprogress) if [ -f calc.py ]; then printf '# stub fix pass\n' >> calc.py; else printf '// stub fix pass\n' >> calc.ts; fi; echo "LOKI_DONE"; exit 0 ;;
    rank) printf '// ranked with ts_rank\n' >> frontend/src/hooks/useApi.ts; echo "LOKI_DONE"; exit 0 ;; # moves the vitestred Wall (C2 passes, C3 still fails)
    fixit) python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; echo "LOKI_DONE"; exit 0 ;;
    cfgfirst) if grep -q '"ok": false' cfg.json; then printf '{"ok": true}\n' > cfg.json
      else python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; fi
      echo "LOKI_DONE"; exit 0 ;;
    linttwice) if grep -q BROKEN_A tool.sh; then printf '#!/usr/bin/env bash\necho BROKEN_B )\n' > tool.sh; else printf '#!/usr/bin/env bash\necho fixed\n' > tool.sh; fi
      echo "LOKI_DONE"; exit 0 ;;
    twostep) # round 1 fixes multiply() but adds a failing extra.test.ts (a different failing set); round 2 fixes that test
      if [ -f extra.test.ts ]; then printf 'import { expect, test } from "bun:test";\nimport { add } from "./calc";\n\ntest("extra", () => {\n  expect(add(1, 1)).toBe(2);\n});\n' > extra.test.ts
      else python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; printf 'import { expect, test } from "bun:test";\nimport { add } from "./calc";\n\ntest("extra", () => {\n  expect(add(1, 1)).toBe(3);\n});\n' > extra.test.ts; fi
      echo "LOKI_DONE"; exit 0 ;;
  esac
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_MODE:-}" = "wallphantom" ]; then
  [ -n "${E2E_STUB_WALL_SLEEP:-}" ] && sleep "$E2E_STUB_WALL_SLEEP"
  printf 'import { expect, test } from "bun:test";\nimport * as calc from "./calc";\n\ntest("multiplyAll", () => {\n  expect((calc as unknown as { multiplyAll: (xs: number[]) => number }).multiplyAll([2, 3])).toBe(6);\n});\n' > loki_wall_multiply.test.ts
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_WALL:-}" = "gopkg" ]; then # a Go Wall test in the package clause of the code under test, not of the tests/ directory it lands in
  printf 'package calc\n\nimport "testing"\n\nfunc TestMultiply(t *testing.T) {\n\tif Multiply(3, 4) != 12 {\n\t\tt.Fatal("want 12")\n\t}\n}\n' > loki_wall_calc_test.go
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_WALL:-}" = "rsnew" ]; then # a Rust Wall test calling Calc::new() with no argument where the crate keeps Calc::new(base)
  printf 'use calc::Calc;\n\n#[test]\nfn doubles() {\n    assert_eq!(Calc::new().double(), 0);\n}\n' > loki_wall_calc.rs
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_WALL:-}" = "rsbase" ]; then # a correct Rust Wall test for a constructor the task changes from new() to new(base)
  printf 'use calc::Calc;\n\n#[test]\nfn starts_from_base() {\n    assert_eq!(Calc::new(5).add(1), 6);\n}\n' > loki_wall_calc.rs
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_WALL:-}" = "vitestred" ]; then # a vitest Wall test for a useSearch hook: C1 passes once the hook exists, C2 once it says ts_rank, C3 never
  printf '%s\n' 'import { test, expect } from "vitest";' 'import { existsSync, readFileSync } from "node:fs";' 'import { dirname, join } from "node:path";' \
    'let root = process.cwd();' 'while (!existsSync(join(root, "frontend")) && dirname(root) !== root) root = dirname(root);' \
    'const src = readFileSync(join(root, "frontend/src/hooks/useApi.ts"), "utf8");' \
    'test("C1 a search hook calls the search API", () => { expect(src).toMatch(/useSearch/); });' \
    'test("C2 results are ranked with ts_rank", () => { expect(src).toMatch(/ts_rank/); });' \
    'test("C3 queries use websearch_to_tsquery", () => { expect(src).toMatch(/websearch_to_tsquery/); });' > loki_wall_search.test.ts
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_MODE:-}" = "wallcolor" ]; then # FC-69: the Wall author writes one red-on-base test for multiply()
  printf 'import { expect, test } from "bun:test";\nimport { multiply } from "./calc";\n\ntest("multiply", () => {\n  expect(multiply(3, 4)).toBe(12);\n});\n' > loki_wall_multiply.test.ts
fi
case "$prompt" in # `loki plan --spec` (tests/min/triage-router.sh): write the schema-checked criteria JSON to the path the brief names
  *"You are the Loki spec stage."*)
    out="$(printf '%s\n' "$prompt" | sed -n 's/.*to this exact file path: //p' | tail -1)"
    [ -n "$out" ] && printf '{"intent":"stub intent","criteria":["the stated change is made","a test covers it"]}\n' > "$out"
    ;;
  *"Project Model discovery step"*) # E2E_STUB_PROJECT (JSON text): the project-model answer, written to the path the brief names
    if [ -n "${E2E_STUB_PROJECT:-}" ]; then
      out="$(printf '%s\n' "$prompt" | sed -n 's/^Write ONLY a JSON object to this file (absolute path): //p' | head -1)"
      [ -n "$out" ] && printf '%s\n' "$E2E_STUB_PROJECT" > "$out"
    fi ;;
  *"PR-sized slices"*) # the MASS-2 split session (tests/min/decompose-and-intake.sh)
    if [ -n "${E2E_STUB_SPLIT:-}" ]; then
      out="$(printf '%s\n' "$prompt" | sed -n 's/^Write exactly one JSON object to the file \(.*\) and nothing else to that file, in this form:$/\1/p' | head -1)"
      # fl24: the real CLI refuses a Write its --settings deny covers. With the whole-.loki/ run-state rule (no HARNESS-OUTPUTS entry for the file) the
      # session prints the split in a fence followed by more than 4096 characters of prose, as Opus did on FireLater#24 (v11.139.0).
      case "$flags" in
        *"Edit(/${out%%/.loki/*}/.loki/**)"*) printf 'A hook blocked the file write. Here is the JSON instead.\n\n```json\n%s\n```\n\n' "$E2E_STUB_SPLIT"; for _ in $(seq 1 60); do echo "Cleanup: I started no processes and created no temp files; the check found no stray loki or test processes."; done ;;
        *) [ -n "$out" ] && printf '%s\n' "$E2E_STUB_SPLIT" > "$out" ;;
      esac
    fi ;;
esac
case "$flags" in *"--model claude (provider default)"*) echo "There's an issue with the selected model (claude (provider default)). It may not exist or you may not have access to it." >&2; exit 1 ;; esac # the real CLI rejects the recorded label as a model id (FireLater#24 s2: every default-model review exited 1)
if [ "$stage" = review ]; then # the seal cross-review (stages/xreview.ts): E2E_STUB_REVIEW=PASS|FLAG|BLOCK answers in claude's --output-format json shape, with a cost
  if [ -n "${E2E_STUB_REVIEW:-}" ]; then printf '{"type":"result","result":"VERDICT: %s\\n- stub reviewer concern","total_cost_usd":0.01}\n' "$E2E_STUB_REVIEW"; fi
  exit 0
fi
if [ "$stage" = "other" ] && [ "${E2E_STUB_MODE:-}" = "overlay" ]; then # tests/min/h2h-harness.sh: a raw `claude -p <task> --output-format json` contestant
  if [ -n "${E2E_STUB_SEEN_LOG:-}" ]; then find . -path ./.git -prune -o -type f -print >> "$E2E_STUB_SEEN_LOG"; fi # every file the contestant could read
  cp -R "$E2E_STUB_OVERLAY"/. .
  echo '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":0.0123,"modelUsage":{"stub-model":{}}}'
  exit 0
fi
if [ "$stage" = "implement" ] && [ "${LOKI_E10_STAGE:-}" = "implement" ] && [ -n "${E2E_STUB_IMPL_CONFLICT:-}" ]; then # every implement session off sonnet answers a spec conflict (tests/min/auto-route.sh)
  case "$flags" in *"--model claude-sonnet"*|*"--model sonnet"*) ;; *) echo "LOKI_SPEC_CONFLICT: $E2E_STUB_IMPL_CONFLICT"; exit 0 ;; esac
fi
if [ "$stage" = "implement" ] && [ "${LOKI_E10_STAGE:-}" = "implement" ] && [ -n "${E2E_STUB_NS_CONFLICT:-}" ]; then # LOKI_E10_OPUS_CONSULT never-stop: implement answers a spec conflict until the never-stop brief; then it implements (E2E_STUB_NS_CONFLICT=wrong: a wrong multiply) and names its ASSUMPTION
  if printf '%s' "$prompt" | grep -q "Do not stop on this conflict"; then
    op='*'; [ "$E2E_STUB_NS_CONFLICT" = "wrong" ] && op='+'
    printf '\nexport function multiply(a: number, b: number): number {\n  return a %s b;\n}\n' "$op" >> calc.ts
    echo "ASSUMPTION: multiply(a, b) is the product"; echo "LOKI_DONE"; exit 0
  fi
  echo "LOKI_SPEC_CONFLICT: the task does not say whether multiply rounds its result"; exit 0
fi
if [ "$stage" = "implement" ] && [ -n "${E2E_STUB_BASE_RED_CONFLICT:-}" ] && ! printf '%s' "$prompt" | grep -q "already fails on the base commit is not a conflict"; then # FireLater#24 s3/s4: the session calls a suite already red on base a spec conflict until the correction says it is not (tests/min/scope-and-fix.sh)
  echo "LOKI_SPEC_CONFLICT: the frontend suite already fails on the base commit, so 'npm run test' cannot pass"; exit 0
fi
if [ "$stage" = "plan" ] && [ "${E2E_STUB_MODE:-}" = "coverage" ]; then # a non-empty plan: the coverage leg with a plan stage must not resume
  out="$(printf '%s\n' "$prompt" | sed -n 's/.*to this exact file path: //p' | head -1)"
  [ -n "$out" ] && printf '1. edit calc.ts\n2. run calc.test.ts\n' > "$out"
fi
if [ "$stage" = "implement" ] && printf '%s' "$prompt" | grep -q "first-choice remedy is not in your change"; then
  printf '// remedy resume\n' >> calc.ts; echo "LOKI_DONE"; exit 0 # F1: the targeted "-rr" resume; a marker edit, never a second copy of the first turn's change
fi
if [ "$stage" = "implement" ] && [ "${E2E_STUB_MODE:-done}" != "coverage" ] && printf '%s' "$prompt" | grep -q "List each site, symbol, example or case"; then
  echo "LOKI_DONE"; exit 0 # the coverage turn (LOKI_E10_COVERAGE_RESUME=1) on a change the first turn completed: a real model edits nothing; replaying the first turn's edit would duplicate it
fi
if [ "$stage" = "implement" ]; then
  sid="$(printf '%s\n' "$prompt" | sed -n 's/^Slice \([A-Za-z0-9_-]*\) of [0-9]* for .*/\1/p' | head -1)"
  if [ -n "${E2E_STUB_CONFLICT_SLICE:-}" ] && [ "$sid" = "$E2E_STUB_CONFLICT_SLICE" ]; then echo "LOKI_SPEC_CONFLICT: slice $sid asks for two incompatible search backends"; exit 0; fi # tests/min/decompose-and-intake.sh: this one slice stops on its own conflict
  if [ "${E2E_STUB_MODE:-done}" = "slice" ] && [ -n "$sid" ]; then
    printf '\nexport function slice_%s(): string {\n  return "%s";\n}\n' "$sid" "$sid" >> calc.ts
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "nochange" ]; then
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "stack" ]; then # tests/min/stacks.sh: replace the LOKI_STUB_INSERT marker (// or # comment) in E2E_STUB_TARGET with E2E_STUB_SNIPPET; E2E_STUB_REPLACE, when set, names the exact text to replace instead
    python3 -I -c 'import os,sys; p=os.environ["E2E_STUB_TARGET"]; n=os.environ["E2E_STUB_SNIPPET"]; o=os.environ.get("E2E_STUB_REPLACE"); s=open(p).read(); open(p,"w").write(s.replace(o, n) if o else s.replace("// LOKI_STUB_INSERT", n).replace("# LOKI_STUB_INSERT", n))'
    tf="${E2E_STUB_TEST_FILE:-calc.test.ts}" # E2E_STUB_TEST_FILE: the test file the two edits below act on (default calc.test.ts)
    [ -n "${E2E_STUB_TEST_DROP:-}" ] && { grep -v -- "$E2E_STUB_TEST_DROP" "$tf" > "$tf.new"; mv "$tf.new" "$tf"; } # E2E_STUB_TEST_DROP: a grep pattern whose lines leave the test file
    [ -n "${E2E_STUB_TEST_APPEND:-}" ] && printf '%s\n' "$E2E_STUB_TEST_APPEND" >> "$tf" # E2E_STUB_TEST_APPEND: text appended to the test file
    [ -n "${E2E_STUB_EDIT_FROM:-}" ] && python3 -I -c 'import os; p=os.environ["E2E_STUB_EDIT_FILE"]; s=open(p).read(); open(p,"w").write(s.replace(os.environ["E2E_STUB_EDIT_FROM"], os.environ["E2E_STUB_EDIT_TO"]))' # E2E_STUB_EDIT_FILE: rewrite E2E_STUB_EDIT_FROM to E2E_STUB_EDIT_TO there (an existing assertion's value)
    [ -n "${E2E_STUB_RM:-}" ] && rm -rf -- "$E2E_STUB_RM" # E2E_STUB_RM: a path (relative to the repo) the change deletes, e.g. an installed package
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "already" ]; then
    echo "LOKI_ALREADY_DONE: calc.ts:1 add already exists"
  elif [ "${E2E_STUB_MODE:-done}" = "alreadyfirst" ] && ! printf '%s' "$prompt" | grep -q "You finished with LOKI_ALREADY_DONE"; then # claims done first; the challenge (below) makes the change
    echo "LOKI_ALREADY_DONE: calc.ts:1 add already exists"
  elif [ "${E2E_STUB_MODE:-done}" = "emptythenalready" ] && ! printf '%s' "$prompt" | grep -q "You finished with LOKI_ALREADY_DONE"; then # LOKI_DONE with no change, then already-done in reply to the empty-done correction; the challenge makes the change
    if printf '%s' "$prompt" | grep -q "working tree has no change against the base"; then echo "LOKI_ALREADY_DONE: calc.ts:1 add already exists"; else echo "LOKI_DONE"; fi
  elif [ "${E2E_STUB_MODE:-done}" = "redothenempty" ]; then # tests/min/auto-route.sh: the empty-done correction after a router redo carries the challenge
    if printf '%s' "$prompt" | grep -q "An earlier session claimed LOKI_ALREADY_DONE" && ! printf '%s' "$prompt" | grep -q "working tree has no change against the base"; then echo "LOKI_DONE"; else echo "LOKI_ALREADY_DONE: calc.ts:1 add already exists"; fi
  elif [ "${E2E_STUB_MODE:-done}" = "editalready" ]; then # adds multiply() and still claims already-done, also after the challenge
    grep -q 'export function multiply' calc.ts || printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts
    echo "LOKI_ALREADY_DONE: calc.ts:1 multiply exists"
  else
    if [ "${E2E_STUB_MODE:-}" = "tamper" ]; then for f in "$(git rev-parse --show-toplevel)"/.loki/runs/*/events.jsonl; do echo '{"v":1,"type":"forged"}' >> "$f"; done; fi
    if [ "${E2E_STUB_MODE:-}" = "scope" ] || [ "${E2E_STUB_MODE:-}" = "unrelated" ]; then echo 'DEBUG = False' >> settings.py; fi
    if [ "${E2E_STUB_MODE:-}" = "unrelated" ]; then echo "LOKI_DONE"; exit 0; fi
    if [[ " 1 update delete mock beforeeach " == *" ${E2E_STUB_TEST_EDIT:-x} "* ]]; then
      [ "${E2E_STUB_TEST_EDIT:-}" = "delete" ] && grep -v 'calc.add(2, 3)' calc.test.ts > calc.test.ts.new && mv calc.test.ts.new calc.test.ts
      [ "${E2E_STUB_TEST_EDIT:-}" != "delete" ] && printf '\ntest("add again", () => {\n  expect(calc.add(1, 1)).toBe(2);\n});\n' >> calc.test.ts
      [ "${E2E_STUB_TEST_EDIT:-}" = "mock" ] && printf '\nconst vi = { mock: (..._a: unknown[]) => {} };\nvi.mock("./util");\n' >> calc.test.ts
      [ "${E2E_STUB_TEST_EDIT:-}" = "beforeeach" ] && printf '\nimport { beforeEach } from "bun:test";\nbeforeEach(() => {});\n' >> calc.test.ts
      [ "${E2E_STUB_TEST_EDIT:-}" = "1" ] && printf '\ntest.skip("add skipped", () => {});\n' >> calc.test.ts
      printf 'import { expect, test } from "bun:test";\nimport { multiply } from "./calc";\n\ntest("multiply", () => {\n  expect(multiply(2, 5)).toBe(10);\n});\n' > multiply.test.ts
    fi
    if [ "${E2E_STUB_SCOPE_EDIT:-}" = "1" ] && [ -f util.ts ]; then printf 'export const MODE = 2;\n' >> util.ts; fi
    if [ "${E2E_STUB_BREAK_CFG:-}" = "1" ] && [ -f cfg.json ]; then printf '{"ok": false}\n' > cfg.json; fi
    if [ "${E2E_STUB_LINTBAD:-}" = "1" ]; then printf '#!/usr/bin/env bash\nif true; then\n  echo BROKEN_A\n' > tool.sh; fi
    if [ "${E2E_STUB_MODE:-}" = "attempts" ]; then # EXP-0010: the session in attempts/B<E2E_STUB_RIGHT> is right, every other one wrong
      n=0; case "$(pwd -P)" in */loki-attempts-*/B[0-9]*) n="$(pwd -P)"; n="${n##*/B}" ;; esac
      op='+'; [ "$n" = "${E2E_STUB_RIGHT:-none}" ] && op='*'
      if [ "$n" = "${E2E_STUB_WEAKEN:-none}" ] && [ -f calc.test.ts ]; then grep -v 'multiply' calc.test.ts > calc.test.ts.new; mv calc.test.ts.new calc.test.ts; fi # E2E_STUB_WEAKEN=<n>: that attempt also drops the multiply assertion, so a wrong multiply() passes
      if [ -n "${E2E_STUB_NEWFILE:-}" ]; then ext=ts; c='//'; [ -f calc.py ] && { ext=py; c='#'; }; printf '%s session %s\n' "$c" "$n" > "new_$n.$ext"; printf '%s shared by every attempt\n' "$c" > "shared_new.$ext"; fi # E2E_STUB_NEWFILE=1: each session also creates new_<n> (its own) and shared_new (the same name in every attempt)
      if [ -f calc.py ]; then printf '\ndef multiply(a, b):\n    return a %s b\n' "$op" >> calc.py
      else printf '\nexport function multiply(a: number, b: number): number {\n  return a %s b;\n}\n' "$op" >> calc.ts; fi
    elif [ "${E2E_STUB_MODE:-}" = "wrong" ]; then
      printf '\nexport function multiply(a: number, b: number): number {\n  return a + b;\n}\n' >> calc.ts
    elif [ "${E2E_STUB_MODE:-}" = "coverage" ]; then # the task names multiply, subtract and negate: the first turn does two of the three, the coverage resume does the third
      if printf '%s' "$prompt" | grep -q "List each site, symbol, example or case"; then printf '\nexport function negate(a: number): number {\n  return -a;\n}\n' >> calc.ts
      elif printf '%s' "$prompt" | grep -q "go over every site, symbol, example or case the task names"; then printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n\nexport function subtract(a: number, b: number): number {\n  return a - b;\n}\n\nexport function negate(a: number): number {\n  return -a;\n}\n' >> calc.ts # the folded coverage line (LOKI_E10_COVERAGE_RESUME default fold): the first turn covers all three
      else printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n\nexport function subtract(a: number, b: number): number {\n  return a - b;\n}\n' >> calc.ts; fi
    elif [ "${E2E_STUB_MODE:-}" = "agentonly" ]; then # multiply() (the visible test exercises it) plus square(), which only a test this session writes calls
      printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n\nexport function square(a: number): number {\n  return a * a;\n}\n' >> calc.ts
      printf 'import { expect, test } from "bun:test";\nimport { square } from "./calc";\n\ntest("square", () => {\n  expect(square(3)).toBe(9);\n});\n' > square.test.ts
    elif [ "${E2E_STUB_MODE:-}" = "viacaller" ]; then # multiply() plus scale(), which no test names but the untouched ops.ts twice() calls (a seeded test calls twice)
      printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n\nexport function scale(a: number, k: number): number {\n  return a * k;\n}\n' >> calc.ts
    elif [ "${E2E_STUB_MODE:-}" = "localvar" ]; then # FC-LEAN-VERIFIED-WITHOUT-CHANGED-SYMBOL: multiply() with a local variable and a comment word a test could echo
      printf '\n// let users multiply two numbers\nexport function multiply(a: number, b: number): number {\n  const result = a * b;\n  return result;\n}\n' >> calc.ts
    else
    printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts
    fi
    echo "LOKI_DONE"
  fi
fi
if [ "$stage" = "implement" ] && [ -n "${E2E_STUB_SLEEP:-}" ]; then sleep "$E2E_STUB_SLEEP"; fi
exit 0
