#!/usr/bin/env bash
# Stub claude CLI for the engine10 e2e test. Modes via E2E_STUB_MODE:
#   done (default): the implement session appends multiply() to calc.ts
#   already: the implement session changes nothing and claims already-done
#   slice: the implement session appends slice_<id>() for the "Slice <id> of N" it was given (tests/min/decompose-and-intake.sh)
#   wrong: the implement session appends a multiply() that adds (calc.test.ts then fails)
#   wallphantom: the Wall author writes loki_wall_multiply.test.ts calling multiplyAll(), a name the task never asks for
#     (red on base, still red after the correct multiply() lands); E2E_STUB_WALL_SLEEP=<s> makes that author session slow
# E2E_STUB_TEST_EDIT=1: the implement session weakens calc.test.ts (adds a test.skip) and adds a new multiply.test.ts;
# =update only appends a test case to calc.test.ts (assertions kept), plus the same new file.
# E2E_STUB_SCOPE_EDIT=1: the implement session also edits util.ts (when the repo has one).
# E2E_STUB_FIX (fix sessions, told apart by LOKI_E10_STAGE=fix): conflict answers LOKI_SPEC_CONFLICT and edits
# nothing; wallconflict does the same citing loki_wall_multiply.test.ts; noprogress edits calc.ts without fixing multiply();
# fixit turns the wrong multiply() right. E2E_STUB_ITER_LOG gets "<stage> <iteration> <prompt bytes>"
# per call; E2E_STUB_USAGE=<n> records n output tokens per session (input = prompt bytes / 4) as the session's cost.
#   overlay: a plain `-p <task>` call copies E2E_STUB_OVERLAY over the cwd (h2h benchmark harness)
# E2E_STUB_SPLIT (JSON text): the MASS-2 split planning session writes it to the file its brief names.
# Every -p call appends its stage name to E2E_STUB_LOG (kept outside the repo); E2E_STUB_BUDGET_LOG gets its LOKI_BUDGET_LIMIT and LEDGER.
set -u
if [ "${1:-}" = "--help" ]; then
  echo "Usage: claude [options] -p <prompt>"
  echo "  --dangerously-skip-permissions --model <m> --settings <json> -p, --print"
  exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then # TEN-STABILITY-09: the P9 login probe in preflight reads this
  echo '{"loggedIn":true}'
  exit 0
fi
prompt=""; flags=""
while [ $# -gt 0 ]; do
  if [ "$1" = "-p" ]; then prompt="${2:-}"; shift; else flags="$flags $1"; fi
  shift
done
case "$prompt" in
  *"Loki 10 plan stage"*) stage=plan ;;
  *"Loki 10 implement stage"*) stage=implement ;;
  *) stage=other ;;
esac
is_wall=0; case "$prompt" in *"Loki 10 Wall author"*) is_wall=1 ;; esac
# One locked append per call: the argv line is several KB (the secret deny rules), and parallel stage calls
# (plan beside wall) would otherwise interleave their writes into broken lines.
if [ -n "${E2E_STUB_ARGV_LOG:-}" ]; then
  lock="$E2E_STUB_ARGV_LOG.lock"; n=0
  until mkdir "$lock" 2>/dev/null; do n=$((n + 1)); [ "$n" -gt 500 ] && break; sleep 0.01; done
  echo "$stage$flags" >> "$E2E_STUB_ARGV_LOG"
  rmdir "$lock" 2>/dev/null || true
fi
if [ -n "${E2E_STUB_LOG:-}" ]; then echo "$stage" >> "$E2E_STUB_LOG"; fi
if [ -n "${E2E_STUB_BUDGET_LOG:-}" ]; then echo "$stage limit=${LOKI_BUDGET_LIMIT:-} ledger=${LOKI_BUDGET_LEDGER:-}" >> "$E2E_STUB_BUDGET_LOG"; fi
if [ -n "${E2E_STUB_PROMPT_LOG:-}" ]; then printf '%s\n' "$prompt" >> "$E2E_STUB_PROMPT_LOG.$stage$is_wall"; fi # CW-12: the full prompt of every call, one file per stage (wall prompts land in .other1)
# What the session can see: the canary test asserts no GitHub token and no LOKI_LEGACY_BASH.
if [ -n "${E2E_STUB_ENV_LOG:-}" ]; then echo "$stage GH_TOKEN=${GH_TOKEN:-} LOKI_LEGACY_BASH=${LOKI_LEGACY_BASH:-} SEAL_PATCH=${LOKI_E10_SEAL_EXISTING_PATCH:-}" >> "$E2E_STUB_ENV_LOG"; fi
if [ -n "${E2E_STUB_ITER_LOG:-}" ]; then echo "${LOKI_E10_STAGE:-none} ${LOKI_ITERATION:-none} ${#prompt}" >> "$E2E_STUB_ITER_LOG"; fi
if [ -n "${E2E_STUB_USAGE:-}" ] && [ -n "${LOKI_ITERATION:-}" ]; then
  mkdir -p .loki/metrics
  printf '{"total_cost_usd":0.01,"input_tokens":%s,"output_tokens":%s,"cache_read_tokens":0,"cache_creation_tokens":0,"model":"stub","source":"e2e-stub"}\n' "$(( ${#prompt} / 4 ))" "$E2E_STUB_USAGE" > ".loki/metrics/result-cost-$LOKI_ITERATION.json"
fi
if [ "${LOKI_E10_STAGE:-}" = "fix" ]; then # before the implement branch: a fix brief also carries the implement rules text
  case "${E2E_STUB_FIX:-}" in
    conflict) echo "LOKI_SPEC_CONFLICT: calc.test.ts:7 expects multiply(3, 4) to be 12"; exit 0 ;;
    wallconflict) echo "LOKI_SPEC_CONFLICT: loki_wall_multiply.test.ts:5 calls multiplyAll, which the task never asks for"; exit 0 ;;
    noprogress) printf '// stub fix pass\n' >> calc.ts; echo "LOKI_DONE"; exit 0 ;;
    fixit) python3 -I -c 's=open("calc.ts").read(); i=s.rfind("return a + b;"); open("calc.ts","w").write(s[:i]+"return a * b;"+s[i+13:])'; echo "LOKI_DONE"; exit 0 ;;
  esac
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_MODE:-}" = "wallphantom" ]; then
  [ -n "${E2E_STUB_WALL_SLEEP:-}" ] && sleep "$E2E_STUB_WALL_SLEEP"
  printf 'import { expect, test } from "bun:test";\nimport * as calc from "./calc";\n\ntest("multiplyAll", () => {\n  expect((calc as unknown as { multiplyAll: (xs: number[]) => number }).multiplyAll([2, 3])).toBe(6);\n});\n' > loki_wall_multiply.test.ts
fi
if [ "$is_wall" = 1 ] && [ "${E2E_STUB_MODE:-}" = "wallcolor" ]; then # FC-69: the Wall author writes one red-on-base test for multiply()
  printf 'import { expect, test } from "bun:test";\nimport { multiply } from "./calc";\n\ntest("multiply", () => {\n  expect(multiply(3, 4)).toBe(12);\n});\n' > loki_wall_multiply.test.ts
fi
case "$prompt" in # `loki plan --spec` (tests/min/triage-router.sh): write the schema-checked criteria JSON to the path the brief names
  *"You are the Loki spec stage."*)
    out="$(printf '%s\n' "$prompt" | sed -n 's/.*to this exact file path: //p' | tail -1)"
    [ -n "$out" ] && printf '{"intent":"stub intent","criteria":["the stated change is made","a test covers it"]}\n' > "$out"
    ;;
  *"PR-sized slices"*) # the MASS-2 split session (tests/min/decompose-and-intake.sh)
    if [ -n "${E2E_STUB_SPLIT:-}" ]; then
      out="$(printf '%s\n' "$prompt" | sed -n 's/^Write exactly one JSON object to the file \(.*\) and nothing else to that file, in this form:$/\1/p' | head -1)"
      [ -n "$out" ] && printf '%s\n' "$E2E_STUB_SPLIT" > "$out"
    fi ;;
esac
if [ "$stage" = "other" ] && [ "${E2E_STUB_MODE:-}" = "overlay" ]; then # tests/min/h2h-harness.sh: a raw `claude -p <task> --output-format json` contestant
  if [ -n "${E2E_STUB_SEEN_LOG:-}" ]; then find . -path ./.git -prune -o -type f -print >> "$E2E_STUB_SEEN_LOG"; fi # every file the contestant could read
  cp -R "$E2E_STUB_OVERLAY"/. .
  echo '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":0.0123,"modelUsage":{"stub-model":{}}}'
  exit 0
fi
if [ "$stage" = "implement" ]; then
  sid="$(printf '%s\n' "$prompt" | sed -n 's/^Slice \([A-Za-z0-9_-]*\) of [0-9]* for .*/\1/p' | head -1)"
  if [ "${E2E_STUB_MODE:-done}" = "slice" ] && [ -n "$sid" ]; then
    printf '\nexport function slice_%s(): string {\n  return "%s";\n}\n' "$sid" "$sid" >> calc.ts
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "nochange" ]; then
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "stack" ]; then # tests/min/stacks.sh: replace the LOKI_STUB_INSERT marker in E2E_STUB_TARGET with E2E_STUB_SNIPPET
    python3 -I -c 'import os,sys; p=os.environ["E2E_STUB_TARGET"]; s=open(p).read(); open(p,"w").write(s.replace("// LOKI_STUB_INSERT", os.environ["E2E_STUB_SNIPPET"]))'
    echo "LOKI_DONE"
  elif [ "${E2E_STUB_MODE:-done}" = "already" ]; then
    echo "LOKI_ALREADY_DONE: calc.ts:1 add already exists"
  else
    if [ "${E2E_STUB_MODE:-}" = "tamper" ]; then for f in "$(git rev-parse --show-toplevel)"/.loki/runs/*/events.jsonl; do echo '{"v":1,"type":"forged"}' >> "$f"; done; fi
    if [ "${E2E_STUB_MODE:-}" = "scope" ] || [ "${E2E_STUB_MODE:-}" = "unrelated" ]; then echo 'DEBUG = False' >> settings.py; fi
    if [ "${E2E_STUB_MODE:-}" = "unrelated" ]; then echo "LOKI_DONE"; exit 0; fi
    if [ "${E2E_STUB_TEST_EDIT:-}" = "1" ] || [ "${E2E_STUB_TEST_EDIT:-}" = "update" ]; then
      printf '\ntest("add again", () => {\n  expect(calc.add(1, 1)).toBe(2);\n});\n' >> calc.test.ts
      [ "${E2E_STUB_TEST_EDIT:-}" = "1" ] && printf '\ntest.skip("add skipped", () => {});\n' >> calc.test.ts
      printf 'import { expect, test } from "bun:test";\nimport { multiply } from "./calc";\n\ntest("multiply", () => {\n  expect(multiply(2, 5)).toBe(10);\n});\n' > multiply.test.ts
    fi
    if [ "${E2E_STUB_SCOPE_EDIT:-}" = "1" ] && [ -f util.ts ]; then printf 'export const MODE = 2;\n' >> util.ts; fi
    if [ "${E2E_STUB_MODE:-}" = "wrong" ]; then
      printf '\nexport function multiply(a: number, b: number): number {\n  return a + b;\n}\n' >> calc.ts
    elif [ "${E2E_STUB_MODE:-}" = "localvar" ]; then # FC-LEAN-VERIFIED-WITHOUT-CHANGED-SYMBOL: multiply() with a local variable and a comment word a test could echo
      printf '\n// let users multiply two numbers\nexport function multiply(a: number, b: number): number {\n  const result = a * b;\n  return result;\n}\n' >> calc.ts
    else
    printf '\nexport function multiply(a: number, b: number): number {\n  return a * b;\n}\n' >> calc.ts
    fi
    echo "LOKI_DONE"
  fi
fi
exit 0
