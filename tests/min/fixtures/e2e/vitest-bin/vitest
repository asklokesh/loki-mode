#!/usr/bin/env python3
# Stand-in vitest for tests/min/run-safety.sh (no network, no node_modules; its own dir so no other test sees it on PATH). `vitest run [--reporter=json --outputFile=F] [files...]`
# in a package dir: each test(...) line is one test; it fails when the line holds /*red*/ or ts_rank, else passes. The first
# describe("...") title is the ancestor. Without --reporter=json it prints what the real vitest prints for those files (non-TTY);
# with it, it writes vitest's JSON report to F. Every call appends "<cwd> json=<0|1> files=<n>" to FAKE_VITEST_LOG.
import json, os, re, sys

args = [a for a in sys.argv[1:] if a != "run"]
as_json = "--reporter=json" in args
out_file = next((a.split("=", 1)[1] for a in args if a.startswith("--outputFile=")), None)
files = [a for a in args if not a.startswith("--")]
cwd = os.getcwd()
if not files:
    for d, dirs, names in os.walk(cwd):
        dirs[:] = [x for x in dirs if x != "node_modules"]
        files += [os.path.relpath(os.path.join(d, n), cwd) for n in names if n.endswith(".test.ts")]
    files.sort()
log = os.environ.get("FAKE_VITEST_LOG")
if log:
    with open(log, "a") as f:
        f.write("%s json=%d files=%d\n" % (cwd, 1 if as_json else 0, len(files)))

results = []
for rel in files:
    text = open(os.path.join(cwd, rel)).read()
    anc = re.findall(r'describe\("([^"]+)"', text)[:1]
    tests = []
    for line in text.splitlines():
        m = re.search(r'\btest\("([^"]+)"', line)
        if m:
            tests.append((m.group(1), "failed" if ("/*red*/" in line or "ts_rank" in line) else "passed"))
    results.append((rel, anc, tests))

if as_json:
    rep = {"numTotalTests": sum(len(t) for _, _, t in results), "testResults": []}
    for rel, anc, tests in results:
        rep["testResults"].append({"name": os.path.realpath(os.path.join(cwd, rel)), "status": "failed" if any(s == "failed" for _, s in tests) else "passed", "message": "",
                                   "assertionResults": [{"status": s, "title": t, "ancestorTitles": anc, "fullName": " ".join(anc + [t]), "failureMessages": ["AssertionError: expected value to match" if s == "failed" else ""][: 1 if s == "failed" else 0]} for t, s in tests]})
    with open(out_file, "w") as f:
        json.dump(rep, f)
else:
    print(" RUN  v4.0.16 %s\n" % cwd)
    for rel, anc, tests in results:
        bad = [t for t, s in tests if s == "failed"]
        print(" %s %s (%d tests%s) 3ms" % ("❯" if bad else "✓", rel, len(tests), " | %d failed" % len(bad) if bad else ""))
        for t, s in tests:
            print("   %s %s 1ms" % ("×" if s == "failed" else "✓", t))
    print("")
    for rel, anc, tests in results:
        for t, s in tests:
            if s == "failed":
                print(" FAIL  %s > %s\nAssertionError: expected value to match\n" % (rel, " > ".join(anc + [t])))
    nf = sum(1 for _, _, t in results if any(s == "failed" for _, s in t))
    failed = sum(1 for _, _, t in results for _, s in t if s == "failed")
    passed = sum(1 for _, _, t in results for _, s in t if s == "passed")
    print(" Test Files  %s (%d)" % (" | ".join(x for x in ["%d failed" % nf if nf else "", "%d passed" % (len(results) - nf) if len(results) - nf else ""] if x), len(results)))
    print("      Tests  %s (%d)" % (" | ".join(x for x in ["%d failed" % failed if failed else "", "%d passed" % passed if passed else ""] if x), failed + passed))
    print("   Duration  10ms")
sys.exit(1 if any(s == "failed" for _, _, t in results for _, s in t) else 0)
